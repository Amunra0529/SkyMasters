              + '<p style="color:#1d4ed8;font-size:14px;font-weight:900;font-family:Montserrat,monospace;margin:0 0 7px;word-break:break-all;line-height:1.2;">' + (cleanPN || 'N/A') + '</p>'
              + '<div style="width:28px;height:2.5px;background:linear-gradient(90deg,#1d4ed8,#60a5fa);border-radius:2px;"></div></div>'
              + '<div style="flex:1;display:flex;flex-direction:column;justify-content:center;padding:14px 18px;background:' + bg + ';">'
              + '<strong style="color:#0f172a;display:block;font-size:11.5px;font-weight:800;margin-bottom:4px;font-family:Montserrat,sans-serif;">Componente Aeron&#225;utico Certificado</strong>'
              + '<span style="color:#334155;font-size:10px;font-weight:500;line-height:1.5;display:block;margin-bottom:7px;font-family:Montserrat,sans-serif;">' + (item.descripcion || 'Pieza de repuesto estandar sujeta a manual de mantenimiento aeronautico.') + '</span>'
              + '<div style="border-top:1px dashed #e2e8f0;padding-top:6px;display:flex;flex-direction:column;gap:2px;">'
              + '<span style="color:#64748b;font-size:8.5px;font-weight:600;font-family:Montserrat,sans-serif;">Solicitante: <strong style="color:#0f172a;">' + (item.solicitante || 'N/A') + '</strong></span>'
              + (tel ? '<span style="color:#475569;font-size:8.5px;font-weight:600;font-family:Montserrat,sans-serif;">Tel&#233;fono: <strong>' + tel + '</strong></span>' : '')
              + (correo ? '<span style="color:#2563eb;font-size:8px;font-weight:600;font-family:Montserrat,sans-serif;word-break:break-all;">Correo: <strong>' + correo + '</strong></span>' : '')
              + '</div></div>'
              + '<div style="width:120px;min-width:120px;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:12px 10px;border-left:1.5px solid ' + bdr + ';background:' + bg + ';text-align:center;">'
              + precioCell
              + '<span style="font-size:7.5px;font-weight:800;padding:3px 8px;border-radius:5px;font-family:Montserrat,sans-serif;' + estadoStyle + '">' + (item.estado || 'En Espera') + '</span>'
              + '</div></div>';
          });

          catalogHtml +=
            '<div style="margin-top:20px;padding-top:12px;border-top:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;font-size:8.5px;color:#94a3b8;font-family:Montserrat,sans-serif;">'
            + '<p style="margin:0;font-weight:600;">SkyMaster Aviation Group &bull; Cat&#225;logo T&#233;cnico &bull; Edici&#243;n ' + currentYear + '</p>'
            + '<p style="margin:0;font-weight:800;color:#0f172a;">www.skymaster.com</p></div>'
            + '</div>';

          const reportContainer = document.createElement('div');
          reportContainer.style.cssText = "background:#ffffff;font-family:Montserrat,sans-serif;width:794px;";
          reportContainer.innerHTML = coverPage + catalogHtml;
          document.body.appendChild(reportContainer);

          // Margen 0 para que la portada use la pagina A4 completa sin recortes
          const opt = {
            margin: 0,
            filename: dynamicFilename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
            pagebreak: { mode: ['css', 'legacy'] }
          };

          try {
            // Numeracion automatica: portada (p.1) sin numero; contenido p.2+ lleva "Pagina X de Y"
            await html2pdf().set(opt).from(reportContainer).toPdf().get('pdf').then(pdf => {
              const total = pdf.internal.getNumberOfPages();
              for (let p = 2; p <= total; p++) {
                pdf.setPage(p);
                pdf.setFontSize(7.5);
                pdf.setTextColor(148, 163, 184);
                const pw = pdf.internal.pageSize.getWidth();
                const ph = pdf.internal.pageSize.getHeight();
                pdf.text('Pagina ' + (p - 1) + ' de ' + (total - 1), pw / 2, ph - 5.5, { align: 'center' });
              }
            }).save();
          } catch (err) {
            console.error('Error al generar catalogo tecnico en PDF:', err);
            alert('Hubo un inconveniente al generar el PDF del catalogo de piezas.');
          } finally {
            document.body.removeChild(reportContainer);
          }
        }


      </script>

</body>

</html>
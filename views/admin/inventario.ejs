          const modal = document.getElementById('noPhotoModal');
          if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }
        }

        function closeGalleryModal(event) {
          if (event.target.id === 'galleryModal') closeGalleryModalForce();
        }

        function closeGalleryModalForce() {
          const modal = document.getElementById('galleryModal');
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        // Exportación Completa del Inventario en PDF (Aeronaves + Piezas) con Tipografía Montserrat
        async function exportInventory() {
          if (!inventoryData || inventoryData.length === 0) {
            alert('No hay registros disponibles en el inventario para exportar.');
            return;
          }

          const currentYear = new Date().getFullYear();
          const dynamicFilename = `skimasters_inventario_${currentYear}.pdf`;

          const fechaEmision = new Date().toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' });

          // Separar aeronaves y piezas en secciones distintas
          const aircraftItems = inventoryData.filter(i => !['part', 'pieza'].includes(i.tipo || i.item_type));
          const partItems = inventoryData.filter(i => ['part', 'pieza'].includes(i.tipo || i.item_type));

          // Helper: generar fila de tabla para reporte
          function buildInventoryRow(item, index, sectionOffset) {
            const isPart = ['part', 'pieza'].includes(item.tipo || item.item_type);
            const rawCode = isPart ? (item.part_number || item.codigo_publico || '') : (item.codigo_publico || '');
            const cleanCode = rawCode.replace(/^SKY-(PAR|AIR)-/i, '');
            const especificaciones = isPart
              ? (item.descripcion || 'Pieza / Repuesto aeronáutico')
              : `Año ${item.anio || 'N/A'} \u2022 ${item.horas_vuelo || 0} Horas Totales \u2022 ${item.ubicacion || 'Internacional'}`;
            const bgRow = (sectionOffset + index) % 2 === 0 ? '#f8fafc' : '#ffffff';
            const correoStr = (item.vendedor_correo || item.correo || item.email || '').trim();
            const telStr = (item.vendedor_telefono || item.contacto || '').trim();
            return `
            <tr style="background:${bgRow};border-bottom:1px solid #e2e8f0;page-break-inside:avoid;font-family:'Montserrat',sans-serif;">
              <td style="padding:9px 7px;font-weight:800;color:#0f172a;font-family:'Montserrat',monospace;vertical-align:top;font-size:10px;">${cleanCode || 'N/A'}</td>
              <td style="padding:9px 7px;vertical-align:top;">
                <strong style="color:#0f172a;display:block;font-size:10.5px;font-weight:800;font-family:'Montserrat',sans-serif;">${isPart ? (cleanCode || 'Repuesto') : (item.modelo || 'Aeronave')}</strong>
                <span style="color:#475569;font-size:9px;font-weight:500;font-family:'Montserrat',sans-serif;display:block;margin-top:2px;">${especificaciones}</span>
              </td>
              <td style="padding:9px 7px;vertical-align:top;font-family:'Montserrat',sans-serif;">
                <strong style="display:block;font-size:10px;color:#0f172a;line-height:1.3;">${item.solicitante || 'N/A'}</strong>
                ${telStr ? `<span style="font-size:8.5px;color:#475569;display:block;line-height:1.4;">${telStr}</span>` : ''}
                ${correoStr ? `<span style="font-size:8px;color:#2563eb;display:block;line-height:1.4;font-weight:600;word-break:break-all;">${correoStr}</span>` : ''}
              </td>
              <td style="padding:9px 7px;text-align:right;color:#334155;font-weight:700;vertical-align:top;font-family:'Montserrat',sans-serif;font-size:10px;">$${Number(item.precio_interno || 0).toLocaleString('en-US')}</td>
              <td style="padding:9px 7px;text-align:right;font-weight:900;color:#d97706;vertical-align:top;font-family:'Montserrat',sans-serif;font-size:10px;">${(item.precio_publico !== null && item.precio_publico !== undefined && item.precio_publico !== '') ? '$' + Number(item.precio_publico).toLocaleString('en-US') : '<span style="color:#94a3b8;font-weight:600;font-style:italic;font-size:9px;">Por asignar</span>'}</td>
              <td style="padding:9px 7px;text-align:center;vertical-align:top;">
                <span style="font-size:8px;font-weight:800;padding:2px 7px;border-radius:4px;font-family:'Montserrat',sans-serif;white-space:nowrap;${item.estado === 'En Venta' ? 'background:#dcfce7;color:#15803d;border:1px solid #bbf7d0;' : item.estado === 'Vendido' ? 'background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;' : 'background:#fef3c7;color:#b45309;border:1px solid #fde68a;'}">${item.estado || 'En Espera'}</span>
              </td>
            </tr>`;
          }

          // Helper: tabla de sección
          function buildSectionTable(items, sectionOffset) {

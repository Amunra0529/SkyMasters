        // Calculadora de Ganancias Comercial en Vivo y Validación del Botón Publicar
        function recalcModalProfit() {
          const pIntInput = document.getElementById('modalPrecioInterno');
          const pPubInput = document.getElementById('modalPrecioPublico');
          const estadoSelect = document.getElementById('modalEstado');

          const pInt = parseFloat(pIntInput.value) || 0;
          const pPubVal = pPubInput.value.trim();
          const pPub = pPubVal !== '' ? parseFloat(pPubVal) : NaN;
          const hasPubPrice = !isNaN(pPub) && pPub > 0;

          const calcInterno = document.getElementById('modalCalcInterno');
          const calcPublico = document.getElementById('modalCalcPublico');
          const calcGanancia = document.getElementById('modalCalcGanancia');
          const calcMargen = document.getElementById('modalCalcMargen');
          const notice = document.getElementById('modalValidationNotice');
          const pubBtn = document.getElementById('modalPublishBtn');

          calcInterno.innerText = `$${pInt.toLocaleString('en-US')}`;

          if (hasPubPrice) {
            calcPublico.innerText = `$${pPub.toLocaleString('en-US')}`;
            const ganancia = pPub - pInt;
            const margenPct = pPub > 0 ? ((ganancia / pPub) * 100).toFixed(1) : 0;

            calcGanancia.innerText = `${ganancia >= 0 ? '+' : ''}$${ganancia.toLocaleString('en-US')} USD`;
            calcGanancia.className = `text-xs sm:text-sm font-extrabold block ${ganancia >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;

            calcMargen.innerText = `${margenPct}%`;
            calcMargen.className = `text-xs sm:text-sm font-extrabold block ${ganancia >= 0 ? 'text-sky-400' : 'text-rose-400'}`;

            if (ganancia >= 0) {
              notice.className = 'rounded-xl p-3 text-xs flex items-center gap-2.5 bg-emerald-500/10 text-emerald-300 border border-emerald-500/30';
              notice.innerHTML = `<svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg><span><strong>Margen comercial positivo:</strong> Rentabilidad estimada de <strong>$${ganancia.toLocaleString('en-US')} USD</strong> (${margenPct}%). Listo para publicación directa.</span>`;
            } else {
              notice.className = 'rounded-xl p-3 text-xs flex items-center gap-2.5 bg-rose-500/10 text-rose-300 border border-rose-500/30';
              notice.innerHTML = `<svg class="w-4 h-4 text-rose-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg><span><strong>Alerta de Margen Negativo:</strong> El precio público es inferior al costo solicitado por el vendedor. Pérdida de <strong>$${Math.abs(ganancia).toLocaleString('en-US')} USD</strong>.</span>`;
            }

            // Habilitar botón de publicar
            pubBtn.disabled = false;
            pubBtn.className = 'flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-xs font-extrabold text-slate-950 bg-emerald-500 hover:bg-emerald-400 transition-all shadow-lg flex items-center justify-center gap-1.5 cursor-pointer active:scale-95';
            pubBtn.title = 'Guardar registro y publicar directamente en catálogo de venta';

          } else {
            calcPublico.innerText = 'No asignado';
            calcGanancia.innerText = 'En espera';
            calcGanancia.className = 'text-xs sm:text-sm font-bold text-slate-500 block';
            calcMargen.innerText = '0%';
            calcMargen.className = 'text-xs sm:text-sm font-bold text-slate-500 block';

            notice.className = 'rounded-xl p-3 text-xs flex items-center gap-2.5 bg-amber-500/10 text-amber-300 border border-amber-500/30';
            notice.innerHTML = `<svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg><span><strong>Publicación Bloqueada:</strong> Ninguna aeronave o pieza puede publicarse si no tiene asignado un "Precio Público". Asigne un valor para desbloquear el botón de publicación.</span>`;

            // Bloquear botón publicar
            pubBtn.disabled = true;
            pubBtn.className = 'flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-500 bg-slate-800 border border-slate-700/60 opacity-50 cursor-not-allowed flex items-center justify-center gap-1.5';
            pubBtn.title = 'Bloqueado: Debe asignar un Precio Público mayor a 0 para publicar';
          }
        }

        // Guardar y Publicar directamente desde el modal
        function submitModalAndPublish() {
          const pPubInput = document.getElementById('modalPrecioPublico');
          const pPub = parseFloat(pPubInput.value);

          if (isNaN(pPub) || pPub <= 0) {
            alert('⚠️ Acción Bloqueada: Ninguna aeronave o pieza puede publicarse si no tiene asignado un "Precio Público".');
            pPubInput.focus();
            pPubInput.classList.add('ring-2', 'ring-rose-500');
            setTimeout(() => pPubInput.classList.remove('ring-2', 'ring-rose-500'), 2500);
            return;
          }

          document.getElementById('modalEstado').value = 'En Venta';
          document.getElementById('inventoryForm').submit();
        }

        // Validación estricta del formulario del modal antes de enviar
        document.getElementById('inventoryForm').addEventListener('submit', function (e) {
          const estado = document.getElementById('modalEstado').value;
          const pPub = parseFloat(document.getElementById('modalPrecioPublico').value);

          if (estado === 'En Venta' && (isNaN(pPub) || pPub <= 0)) {
            e.preventDefault();
            alert('⚠️ Validación de Publicación: Ninguna aeronave o pieza puede registrarse o actualizarse con estado "En Venta" si el Precio Público está vacío o es 0.');
            const pubInput = document.getElementById('modalPrecioPublico');
            pubInput.focus();
            pubInput.classList.add('ring-2', 'ring-rose-500');
            setTimeout(() => pubInput.classList.remove('ring-2', 'ring-rose-500'), 2500);
            return false;
          }
        });

        // Filtro por Pestañas (Tabs)
        let currentTab = 'all';

        function switchTab(tab) {
          currentTab = tab;
          document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('bg-amber-500', 'text-slate-950');
            btn.classList.add('text-slate-400');
          });

          const activeBtn = document.getElementById('tab-' + tab);
          if (activeBtn) {
            activeBtn.classList.add('bg-amber-500', 'text-slate-950');
            activeBtn.classList.remove('text-slate-400');
          }

          // Control dinámico de visibilidad del botón de exportar piezas
          const btnParts = document.getElementById('btnExportParts');
          if (btnParts) {
            if (tab === 'part') {
              btnParts.classList.remove('hidden'); // Muestra el botón solo en Piezas
            } else {
              btnParts.classList.add('hidden');    // Oculta el botón en "Todos" o "Aeronaves"
            }
          }

          filterInventory();
        }

        // Sistema de Paginación Dinámica (10 registros por página ordenados por más recientes)
        const PAGE_SIZE = 10;
        let currentPage = 1;
        let currentMatchingRows = [];

        function filterInventory(resetPage = true) {
          if (resetPage) currentPage = 1;
          const search = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
          const status = document.getElementById('statusFilter')?.value || 'all';
          const allRows = Array.from(document.querySelectorAll('.inventory-row'));

          currentMatchingRows = [];

          allRows.forEach(row => {
            const typeMatch = currentTab === 'all' || row.dataset.type === currentTab;
            const statusMatch = status === 'all' || row.dataset.status === status;
            const textMatch = search === '' || row.innerText.toLowerCase().includes(search);

            if (typeMatch && statusMatch && textMatch) {
              currentMatchingRows.push(row);
            } else {
              row.style.display = 'none';
            }
          });

          renderPagination();
        }

        function renderPagination() {
          const total = currentMatchingRows.length;
          const totalPages = Math.ceil(total / PAGE_SIZE) || 1;

          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          const startIndex = (currentPage - 1) * PAGE_SIZE;
          const endIndex = Math.min(startIndex + PAGE_SIZE, total);

          // Mostrar únicamente las filas correspondientes a la página activa
          currentMatchingRows.forEach((row, idx) => {
            if (idx >= startIndex && idx < endIndex) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });

          const paginationContainer = document.getElementById('paginationContainer');
          const pageStart = document.getElementById('pageStart');
          const pageEnd = document.getElementById('pageEnd');
          const pageTotal = document.getElementById('pageTotal');
          const paginationButtons = document.getElementById('paginationButtons');
          const btnPrev = document.getElementById('btnPrevPage');
          const btnNext = document.getElementById('btnNextPage');

          if (pageStart) pageStart.innerText = total === 0 ? 0 : startIndex + 1;
          if (pageEnd) pageEnd.innerText = endIndex;
          if (pageTotal) pageTotal.innerText = total;

          // Mostrar el paginador únicamente cuando los registros superen los 10
          if (total > PAGE_SIZE) {
            if (paginationContainer) {
              paginationContainer.classList.remove('hidden');
              paginationContainer.classList.add('flex');
            }
          } else {
            if (paginationContainer) {
              paginationContainer.classList.add('hidden');
              paginationContainer.classList.remove('flex');
            }
          }

          if (btnPrev) btnPrev.disabled = currentPage <= 1;
          if (btnNext) btnNext.disabled = currentPage >= totalPages;

          if (paginationButtons) {
            paginationButtons.innerHTML = '';
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) {
              startPage = Math.max(1, endPage - 4);
            }

            if (startPage > 1) {
              paginationButtons.appendChild(createPageBtn(1, 1 === currentPage));
              if (startPage > 2) {
                const dots = document.createElement('span');
                dots.className = 'px-1 text-slate-500 font-bold text-xs select-none';
                dots.innerText = '...';
                paginationButtons.appendChild(dots);
              }
            }

            for (let p = startPage; p <= endPage; p++) {
              paginationButtons.appendChild(createPageBtn(p, p === currentPage));
            }

            if (endPage < totalPages) {
              if (endPage < totalPages - 1) {
                const dots = document.createElement('span');
                dots.className = 'px-1 text-slate-500 font-bold text-xs select-none';
                dots.innerText = '...';
                paginationButtons.appendChild(dots);
              }
              paginationButtons.appendChild(createPageBtn(totalPages, totalPages === currentPage));
            }
          }
        }

        function createPageBtn(pageNum, isActive) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.innerText = pageNum;
          btn.onclick = () => changePage(pageNum);
          if (isActive) {
            btn.className = 'w-8 h-8 rounded-lg text-xs font-black bg-amber-500 text-slate-950 shadow-md cursor-default';
          } else {
            btn.className = 'w-8 h-8 rounded-lg text-xs font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white border border-slate-700 transition-all cursor-pointer';
          }
          return btn;
        }

        function changePage(page) {
          const total = currentMatchingRows.length;
          const totalPages = Math.ceil(total / PAGE_SIZE) || 1;
          if (page < 1 || page > totalPages) return;
          currentPage = page;
          renderPagination();
        }

        // Cambio Dinámico de Estado con Validación Estricta
        async function updateRowStatus(uid, newStatus) {
          const item = findItemByUid(uid);
          if (!item) return;

          // Validación estricta: Bloquear cambio a "En Venta" si no tiene precio público
          if (newStatus === 'En Venta') {
            const priceInput = document.getElementById('precio-publico-' + uid);
            const currentPrice = priceInput && priceInput.value !== '' ? parseFloat(priceInput.value) : parseFloat(item.precio_publico);
            if (isNaN(currentPrice) || currentPrice <= 0) {
              alert('⚠️ Acción Bloqueada: Ninguna aeronave o pieza puede publicarse si no tiene asignado un "Precio Público". Por favor, ingrese un precio válido.');
              const selectElem = document.getElementById('status-select-' + uid);
              if (selectElem) selectElem.value = item.estado || 'En Espera';
              if (priceInput) {
                priceInput.focus();
                priceInput.classList.add('ring-2', 'ring-rose-500');
                setTimeout(() => priceInput.classList.remove('ring-2', 'ring-rose-500'), 2500);
              }
              return;
            }
          }

          const previousStatus = item.estado;
          item.estado = newStatus;

          const row = document.getElementById('row-' + uid);
          if (row) {
            row.dataset.status = newStatus;
          }

          const selectElem = document.getElementById('status-select-' + uid);
          if (selectElem) selectElem.value = newStatus;

          const pubBtn = document.getElementById('pub-btn-' + uid);
          if (pubBtn) {
            if (newStatus === 'En Venta') {
              pubBtn.style.display = 'none';
            } else {
              pubBtn.style.display = 'inline-flex';
            }
          }

          filterInventory();
          updateActiveCounts();

          try {
            const response = await fetch('/sales/admin/inventario/' + item.id + '/status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ id: item.id, tipo: item.tipo, estado: newStatus })
            });
            const data = await response.json();
            if (!data.success) {
              alert(data.message || 'Error al cambiar estado.');
              item.estado = previousStatus;
              if (row) row.dataset.status = previousStatus;
              if (selectElem) selectElem.value = previousStatus;
              updateActiveCounts();
            }
          } catch (err) {
            console.warn('Error al actualizar estado:', err);
          }
        }

        // Sistema de Eliminación
        function requestDelete(uid) {
          const item = findItemByUid(uid);
          if (!item) return;

          deleteTargetUid = uid;
          document.getElementById('deleteItemTitle').innerText = `"${item.codigo_publico || item.modelo}"`;

          const modal = document.getElementById('deleteModal');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }

        function closeDeleteModal() {
          deleteTargetUid = null;
          const modal = document.getElementById('deleteModal');
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        async function confirmDelete() {
          if (!deleteTargetUid) return;
          const item = findItemByUid(deleteTargetUid);
          if (!item) return;

          const row = document.getElementById('row-' + deleteTargetUid);
          if (row) row.remove();

          closeDeleteModal();
          updateActiveCounts();
          filterInventory(false);

          try {
            await fetch('/sales/admin/inventario/' + item.id + '/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: item.id, tipo: item.tipo })
            });
          } catch (err) {
            console.warn('Error al eliminar registro:', err);
          }
        }


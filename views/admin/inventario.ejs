          const sectionAircraftSpecs = document.getElementById('sectionAircraftSpecs');
          const sectionAircraftDocs = document.getElementById('sectionAircraftDocs');
          const fieldPartNumber = document.getElementById('fieldPartNumber');
          const fieldPartDescripcion = document.getElementById('fieldPartDescripcion');

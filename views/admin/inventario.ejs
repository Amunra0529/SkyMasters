              docsDiv.innerHTML += `<a href="${item.damage_history_url}" target="_blank" class="px-3 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border border-rose-500/30 rounded-lg flex items-center gap-1.5 font-bold transition-all">📄 Historial de Daños PDF</a>`;

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Manejo de Inventario | SkyMaster Admin' %>
  </title>
  <link rel="stylesheet" href="/css/styles.css">
  <!-- Tailwind CSS por CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tipografía Montserrat de Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">
  <!-- Biblioteca html2pdf.js para descarga directa de PDF sin ventana de impresión -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <style>
    body {
      font-family: 'Montserrat', sans-serif;
    }

    /* Quitar flechas y selectores numéricos en inputs tipo number */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    input[type="number"] {
      -moz-appearance: textfield;
      appearance: textfield;
    }

    @page {
      margin: 0;
      size: A4 portrait;
    }

    @media print {

      html,
      body {
        width: 100% !important;
        height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
      }

      body * {
        visibility: hidden !important;
      }

      #fichaModal,
      #fichaModal * {
        visibility: visible !important;
      }

      #fichaModal {
        display: flex !important;
        justify-content: center !important;
        align-items: flex-start !important;
        position: absolute !important;
        inset: 0 !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: auto !important;
        min-height: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        background: #ffffff !important;
        z-index: 99999 !important;
      }

      #printableFichaModal {
        margin: 0 auto !important;
        width: 100% !important;
        max-width: 750px !important;
        box-shadow: none !important;
        transform: scale(0.85) !important;
        transform-origin: top center !important;
        background: #ffffff !important;
        color: #000000 !important;
        border: none !important;
      }

      #fichaModalDownloadArea {
        margin: 0 auto !important;
        width: 750px !important;
        min-width: 750px !important;
        max-width: 750px !important;
        padding: 20px 24px !important;
        box-sizing: border-box !important;
        display: block !important;
        box-shadow: none !important;
      }

      .no-print,
      .hide-on-pdf,
      #fichaCloseBtnContainer,
      #fichaValidezContainer {
        display: none !important;
        visibility: hidden !important;
      }
    }

    /* Estilos para exportación a PDF (html2pdf / html2canvas) */
    .pdf-exporting {
      display: block !important;
      position: relative !important;
      top: 0 !important;
      left: 0 !important;
      margin: 0 auto !important;
      box-sizing: border-box !important;
      width: 750px !important;
      min-width: 750px !important;
      max-width: 750px !important;
      padding: 20px 24px !important;
      background: #ffffff !important;
      box-shadow: none !important;
      border: none !important;
    }

    .pdf-exporting .hide-on-pdf,
    .pdf-exporting .no-print,
    .pdf-exporting #fichaCloseBtnContainer,
    .pdf-exporting #fichaValidezContainer {
      display: none !important;
      visibility: hidden !important;
    }

    /* ── Scrollbar personalizada: estética oscura/dorada para el modal de edición ── */
    #inventoryForm::-webkit-scrollbar {
      width: 5px;
    }

    #inventoryForm::-webkit-scrollbar-track {
      background: #040812;
      border-radius: 99px;
    }

    #inventoryForm::-webkit-scrollbar-thumb {
      background: #f59e0b55;
      border-radius: 99px;
    }

    #inventoryForm::-webkit-scrollbar-thumb:hover {
      background: #f59e0b;
    }

    #inventoryForm {
      scrollbar-width: thin;
      scrollbar-color: #f59e0b55 #040812;
    }
  </style>
</head>

<body class="bg-slate-900 text-slate-100 font-sans min-h-screen flex flex-col justify-between">

  <!-- Inclusión de Barra de Navegación Administrativa -->
  <%- include('../partials/navbar_admin') %>

    <!-- Panel Principal de Gestión de Inventario -->
    <main class="main-content flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

      <!-- Encabezado de la Sección -->
      <div
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-slate-700/80 mb-6">
        <div>
          <span class="text-xs text-amber-400 font-bold uppercase tracking-widest block">Panel de Control
            Ejecutivo</span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Gestión de Solicitudes de Venta</h1>
          <p class="text-slate-300 text-xs sm:text-sm mt-1">Administra y publica las aeronaves y piezas subidas por los
            clientes para venta pública.</p>
        </div>

        <!-- Contenedor Flex para alinear botones principales -->
        <div class="flex items-center gap-3 self-start md:self-auto">
          <!-- Botón Secundario: Exportar Inventario -->
          <button onclick="exportInventory()"
            class="inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-semibold border border-slate-700 px-4 py-2.5 rounded-xl text-sm transition-all active:scale-95 shadow-md">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z">
              </path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9h1"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 13h1.5a1 1 0 001-1v-1a1 1 0 00-1-1H9v5m6-5h-1.5v5m1.5-2.5H15"></path>
            </svg>
            <span>Exportar inventario</span>
          </button>

          <!-- Botón Principal: Nueva Publicación -->
          <button onclick="openModal('create')"
            class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold px-5 py-2.5 rounded-xl text-sm transition-all shadow-lg hover:shadow-amber-500/20 active:scale-95">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Nueva Publicación</span>
          </button>
        </div>
      </div>

      <!-- Tarjetas de Métricas Rápidas con fondo y textos claros -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 my-6">
        <div
          class="bg-slate-800/90 border border-slate-700 p-4 rounded-xl flex items-center justify-between shadow-lg backdrop-blur-sm hover:border-slate-600 transition-all">
          <div>
            <p class="text-slate-300 text-xs font-bold uppercase tracking-wider">Solicitudes Aeronaves</p>
            <p class="text-2xl font-black text-white mt-1" id="stat-aircraft-count">0</p>
          </div>
          <div class="bg-amber-500/15 text-amber-400 p-3 rounded-lg border border-amber-500/30">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
        </div>

        <div
          class="bg-slate-800/90 border border-slate-700 p-4 rounded-xl flex items-center justify-between shadow-lg backdrop-blur-sm hover:border-slate-600 transition-all">
          <div>
            <p class="text-slate-300 text-xs font-bold uppercase tracking-wider">Solicitudes Piezas & Repuestos</p>
            <p class="text-2xl font-black text-white mt-1" id="stat-parts-count">0</p>
          </div>
          <div class="bg-amber-500/15 text-amber-400 p-3 rounded-lg border border-amber-500/30">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            </svg>
          </div>
        </div>

        <div
          class="bg-slate-800/90 border border-slate-700 p-4 rounded-xl flex items-center justify-between shadow-lg backdrop-blur-sm hover:border-slate-600 transition-all">
          <div>
            <p class="text-slate-300 text-xs font-bold uppercase tracking-wider">Publicadas En Venta</p>
            <p class="text-2xl font-black text-emerald-400 mt-1" id="stat-active-count">0</p>
          </div>
          <div class="bg-emerald-500/15 text-emerald-400 p-3 rounded-lg border border-emerald-500/30">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>

        <div
          class="bg-slate-800/90 border border-slate-700 p-4 rounded-xl flex items-center justify-between shadow-lg backdrop-blur-sm hover:border-slate-600 transition-all">
          <div>
            <p class="text-slate-300 text-xs font-bold uppercase tracking-wider">Total Registros</p>
            <p class="text-2xl font-black text-amber-400 mt-1" id="stat-total-count">0</p>
          </div>
          <div class="bg-amber-500/15 text-amber-400 p-3 rounded-lg border border-amber-500/30">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Barra de Filtros, Búsqueda y Pestañas -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <!-- Tabs de Categoría -->
        <div class="flex bg-slate-950/70 p-1.5 rounded-xl border border-slate-700 w-full sm:w-auto shadow-inner">
          <button onclick="switchTab('all')" id="tab-all"
            class="tab-btn flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold transition-all bg-amber-500 text-slate-950 shadow-md">
            Todos
          </button>
          <button onclick="switchTab('aircraft')" id="tab-aircraft"
            class="tab-btn flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            Aeronaves
          </button>
          <button onclick="switchTab('part')" id="tab-part"
            class="tab-btn flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            </svg>
            Piezas & Repuestos
          </button>
        </div>

        <!-- Búsqueda y Filtro de Estado -->
        <div class="flex items-center gap-3 w-full sm:w-auto">

          <!-- Botón exclusivo para exportar piezas (Inicia oculto con class="hidden") -->
          <button id="btnExportParts" onclick="exportPartsCatalogPDF()"
            class="hidden inline-flex items-center justify-center gap-2 bg-sky-600/20 hover:bg-sky-600 text-sky-300 hover:text-white font-semibold border border-sky-500/40 px-3.5 py-2.5 rounded-xl text-xs transition-all shadow-sm cursor-pointer">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
              </path>
            </svg>
            <span>Exportar Catálogo de Piezas</span>
          </button>

          <div class="relative w-full sm:w-80">
            <input type="text" id="searchInput" onkeyup="filterInventory()"
              placeholder="Buscar por código, modelo, cliente..."
              class="w-full bg-slate-800 border border-slate-700 text-xs text-white placeholder-slate-400 rounded-xl px-3.5 py-2.5 pl-9 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400/30 transition-colors shadow-sm">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>

          <select id="statusFilter" onchange="filterInventory()"
            class="bg-slate-800 border border-slate-700 text-xs text-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:border-amber-400 font-semibold cursor-pointer shadow-sm">
            <option value="all">Todos los Estados</option>
            <option value="En Espera">En Espera</option>
            <option value="En Venta">En Venta</option>
            <option value="Vendido">Vendido</option>
          </select>
        </div>
      </div>

      <!-- Tabla de Registros con Contraste Mejorado -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl overflow-hidden shadow-2xl backdrop-blur-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr
                class="bg-slate-900/95 text-slate-200 border-b border-slate-700 uppercase text-[10px] tracking-wider font-bold">
                <th class="py-3 px-3">Código / Registro</th>
                <th class="py-3 px-3">Especificaciones & Contacto</th>
                <th class="py-3 px-3 text-center">Archivos Adjuntos</th>
                <th class="py-3 px-3 text-right">Precio Interno (USD)</th>
                <th class="py-3 px-3 text-center">Precio Público (USD)</th>
                <th class="py-3 px-3 text-right text-emerald-400">Ganancia Est.</th>
                <th class="py-3 px-3 text-center">Estado Comercial</th>
                <th class="py-3 px-3 text-center">Acciones</th>
              </tr>
            </thead>
            <tbody id="inventoryTableBody" class="divide-y divide-slate-700/60 text-xs text-slate-200">

              <% if (typeof inventory !=='undefined' && inventory.length> 0) { %>
                <% inventory.forEach(item=> { %>
                  <% const itemUid=item.uid || (item.tipo + '_' + item.id); %>
                    <% const isPart=(item.tipo==='part' || item.tipo==='pieza' || item.item_type==='part' ); %>
                      <% const hasCustomImg=Boolean(item.has_custom_images && item.imagen_url && item.imagenes &&
                        item.imagenes.length> 0); %>
                        <% const canPublish=Boolean(item.precio_publico !==null && item.precio_publico !==undefined &&
                          item.precio_publico !=='' && Number(item.precio_publico)> 0); %>
                          <tr id="row-<%= itemUid %>"
                            class="inventory-row hover:bg-slate-700/40 transition-colors border-b border-slate-700/50"
                            data-uid="<%= itemUid %>" data-type="<%= item.tipo || item.item_type %>"
                            data-status="<%= item.estado %>" data-id="<%= item.id %>">
                            <td class="py-3 px-3 min-w-[170px]">
                              <div class="flex items-center gap-3">
                                <% if (hasCustomImg) { %>
                                  <img src="<%= item.imagen_url %>" onclick="openGalleryModal('<%= itemUid %>')"
                                    title="Haz clic para abrir la galería"
                                    onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');"
                                    class="w-12 h-10 object-cover rounded-lg border border-slate-600 cursor-pointer hover:border-amber-400 hover:scale-105 transition-all shadow-md flex-shrink-0">
                                  <div
                                    class="hidden w-12 h-10 rounded-lg border border-slate-700 bg-slate-900 flex flex-col items-center justify-center flex-shrink-0 text-slate-400">
                                    <span class="text-[7px] font-extrabold uppercase">Sin foto</span>
                                  </div>
                                  <% } else if (isPart) { %>
                                    <!-- Pieza sin imágenes: icono estético de sin imagen sin cargar foto por defecto -->
                                    <div
                                      class="w-12 h-10 rounded-lg border border-slate-700 bg-slate-900 flex flex-col items-center justify-center flex-shrink-0 text-slate-400 shadow-sm"
                                      title="Pieza sin fotografías registradas">
                                      <svg class="w-4 h-4 text-slate-400 mb-0.5" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
                                          d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                        <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="1.6" />
                                      </svg>
                                      <span
                                        class="text-[7px] font-extrabold text-slate-400 uppercase tracking-tighter">Sin
                                        foto</span>
                                    </div>
                                    <% } else { %>
                                      <img src="<%= item.imagen_url || '/img/card_sales.jpg' %>"
                                        onclick="openGalleryModal('<%= itemUid %>')"
                                        title="Haz clic para abrir la galería"
                                        onerror="this.onerror=null; this.src='/img/card_sales.jpg';"
                                        class="w-12 h-10 object-cover rounded-lg border border-slate-600 cursor-pointer hover:border-amber-400 hover:scale-105 transition-all shadow-md flex-shrink-0">
                                      <% } %>
                                        <div class="min-w-0">
                                          <span
                                            class="inline-block text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30 font-bold mb-0.5 break-words max-w-[140px]"
                                            title="<%= item.part_number || item.codigo_publico %>">
                                            <%= isPart ? (item.part_number || item.codigo_publico || ''
                                              ).replace(/^SKY-(PAR|AIR)-/i, '' ) : (item.codigo_publico || ''
                                              ).replace(/^SKY-(PAR|AIR)-/i, '' ) %>
                                          </span>
                                          <p class="font-bold text-white text-xs item-title break-words max-w-[140px]">
                                            <%= item.modelo %>
                                          </p>
                                          <p class="text-[11px] text-slate-300 font-medium truncate max-w-[140px]">
                                            <%= item.solicitante %>
                                          </p>
                                        </div>
                              </div>
                            </td>
                            <td class="py-3 px-3 text-[11px] text-slate-200">
                              <% if (!isPart) { %>
                                <p class="font-bold text-white">Año <%= item.anio || 'N/A' %> &bull; <%=
                                      item.horas_vuelo || 0 %> Horas Totales</p>
                                <p class="text-slate-300"><span class="text-slate-400 font-medium">Locación:</span>
                                  <%= item.ubicacion || 'Internacional' %>
                                </p>
                                <p class="text-slate-300"><span class="text-slate-400 font-medium">Contacto:</span>
                                  <%= item.contacto %>
                                </p>
                                <% } else { %>
                                  <% const _pn=(item.part_number || item.codigo_publico || ''
                                    ).replace(/^SKY-(PAR|AIR)-/i, '' ); %>
                                    <p class="font-bold text-white"><span class="text-slate-400 font-medium">Part
                                        Number:</span> <span class="font-mono text-amber-300 font-bold">
                                        <%= _pn %>
                                      </span>
                                    </p>
                                    <p class="text-slate-300 line-clamp-2 max-w-xs"><span
                                        class="text-slate-400 font-medium">Desc:</span>
                                      <%= item.descripcion || 'Pieza aeronáutica' %>
                                    </p>
                                    <p class="text-slate-300"><span class="text-slate-400 font-medium">Contacto:</span>
                                      <%= item.contacto %>
                                    </p>
                                    <% } %>
                            </td>
                            <td class="py-3 px-3 text-center">
                              <!-- Columna de Archivos Adjuntos con diseño compacto vertical que elimina el scroll horizontal -->
                              <div class="flex flex-col items-center justify-center gap-1.5 max-w-[125px] mx-auto">

                                <!-- Galería Fotos -->
                                <button type="button" onclick="openGalleryModal('<%= itemUid %>')"
                                  class="inline-flex items-center justify-center gap-1.5 w-full bg-slate-700/80 hover:bg-slate-700 text-slate-100 text-[10px] px-2.5 py-1 rounded-lg border border-slate-600 transition-all hover:border-amber-400 font-semibold <%= (!hasCustomImg && isPart) ? 'opacity-60' : '' %>">
                                  <svg class="w-3.5 h-3.5 text-amber-400 flex-shrink-0" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                  </svg>
                                  <span class="font-bold">
                                    <%= item.has_custom_images ? (item.imagenes ? item.imagenes.length : 1) : 0 %> Fotos
                                  </span>
                                </button>

                                <!-- Archivos PDF apilados verticalmente -->
                                <% if (item.log_books_url || item.damage_history_url) { %>
                                  <div class="flex flex-col items-center gap-1 w-full">
                                    <% if (item.log_books_url) { %>
                                      <a href="<%= item.log_books_url %>" target="_blank" title="Ver Bitácoras PDF"
                                        class="inline-flex items-center justify-center gap-1 w-full bg-red-500/15 hover:bg-red-500/25 text-red-300 text-[10px] px-2 py-0.5 rounded border border-red-500/40 transition-all font-semibold">
                                        <svg class="w-2.5 h-2.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                          <path
                                            d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" />
                                        </svg>
                                        <span class="truncate">Bitácoras</span>
                                      </a>
                                      <% } %>
                                        <% if (item.damage_history_url) { %>
                                          <a href="<%= item.damage_history_url %>" target="_blank"
                                            title="Ver Historial Daños PDF"
                                            class="inline-flex items-center justify-center gap-1 w-full bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 text-[10px] px-2 py-0.5 rounded border border-rose-500/40 transition-all font-semibold">
                                            <svg class="w-2.5 h-2.5 flex-shrink-0" fill="currentColor"
                                              viewBox="0 0 20 20">
                                              <path
                                                d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" />
                                            </svg>
                                            <span class="truncate">Historial</span>
                                          </a>
                                          <% } %>
                                  </div>
                                  <% } %>
                              </div>
                            </td>
                            <td class="py-3 px-3 text-right font-bold text-slate-100 text-sm">
                              $<%= Number(item.precio_interno || 0).toLocaleString('en-US') %>
                            </td>
                            <td class="py-3 px-3 text-center">
                              <!-- Input para Asignar Precio Público sin spinners/flechas -->
                              <div class="flex items-center justify-center gap-1 max-w-[130px] mx-auto">
                                <span class="text-slate-400 font-bold">$</span>
                                <input type="number" step="0.01" min="0" placeholder="0.00"
                                  id="precio-publico-<%= itemUid %>"
                                  value="<%= item.precio_publico !== null && item.precio_publico !== undefined ? item.precio_publico : '' %>"
                                  oninput="handlePrecioPublicoLiveChange('<%= itemUid %>', this.value)"
                                  onchange="savePrecioPublico('<%= itemUid %>', this.value)"
                                  class="w-24 bg-slate-900 border border-slate-600 text-xs font-bold text-amber-300 rounded-lg px-2 py-1.5 focus:outline-none focus:border-amber-400 text-right [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
                              </div>
                            </td>
                            <td class="py-3 px-3 text-right font-bold" id="ganancia-<%= itemUid %>">
                              <% if (item.precio_publico !==null && item.precio_publico !==undefined &&
                                item.precio_publico !=='' ) { %>
                                <% const diff=Number(item.precio_publico) - Number(item.precio_interno || 0); %>
                                  <span
                                    class="<%= diff >= 0 ? 'text-emerald-400 font-extrabold text-sm' : 'text-rose-400 font-extrabold text-sm' %>">$
                                    <%= diff.toLocaleString('en-US') %>
                                  </span>
                                  <% } else { %>
                                    <span class="text-slate-400 text-[10px] italic">En espera de precio</span>
                                    <% } %>
                            </td>
                            <td class="py-3 px-3 text-center">
                              <div class="flex flex-col items-center gap-1">
                                <select onchange="updateRowStatus('<%= itemUid %>', this.value)"
                                  id="status-select-<%= itemUid %>"
                                  class="bg-slate-900 border border-slate-600 text-slate-100 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-amber-400 font-semibold cursor-pointer">
                                  <option value="En Espera" <%=item.estado==='En Espera' ? 'selected' : '' %>>En Espera
                                  </option>
                                  <option value="En Venta" <%=item.estado==='En Venta' ? 'selected' : '' %>>En Venta
                                  </option>
                                  <option value="Vendido" <%=item.estado==='Vendido' ? 'selected' : '' %>>Vendido
                                  </option>
                                </select>
                              </div>
                            </td>
                            <td class="py-3 px-3 text-center">
                              <div
                                class="inline-flex items-center bg-slate-900 border border-slate-700 rounded-xl p-1 gap-1 shadow-inner">
                                <!-- Botón Publicar Directo con Validación Estricta -->
                                <% if (item.estado !=='En Venta' ) { %>
                                  <button type="button" onclick="handlePublishClick('<%= itemUid %>')"
                                    id="pub-btn-<%= itemUid %>" data-enabled="<%= canPublish ? 'true' : 'false' %>"
                                    class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded transition-all shadow-sm <%= canPublish ? 'bg-emerald-500/20 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 border border-emerald-500/40 cursor-pointer' : 'bg-slate-800 text-slate-400 border border-slate-700 opacity-50 cursor-not-allowed' %>"
                                    title="<%= canPublish ? 'Publicar directamente en venta' : 'Bloqueado: Debe asignar un Precio Público antes de publicar' %>">
                                    Publicar
                                  </button>
                                  <% } %>
                                    <!-- Icono 1: Ver Detalles (Ojito) -->
                                    <button onclick="viewDetailsModal('<%= itemUid %>')"
                                      class="p-1.5 text-slate-300 hover:text-sky-400 hover:bg-sky-500/10 rounded-lg transition-all"
                                      title="Ver Detalles Completos">
                                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                      </svg>
                                    </button>

                                    <!-- Icono 2: Generar Ficha Técnica PDF -->
                                    <button onclick="openFichaTecnica('<%= itemUid %>')"
                                      class="p-1.5 text-slate-300 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all"
                                      title="Generar Ficha Técnica PDF">
                                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                      </svg>
                                    </button>

                                    <!-- Icono 3: Contacto WhatsApp → mensaje dinámico al VENDEDOR/SOLICITANTE -->
                                    <% /* Teléfono del vendedor (limpiado de caracteres no numéricos) */ const
                                      vendedorWA=(item.vendedor_telefono || '584120000000' ).replace(/[^0-9]/g, '' ); /*
                                      Nombre completo del solicitante */ const solicitanteNombre=item.solicitante
                                      || 'Estimado/a cliente' ; /* Part Number limpio para admin (sin prefijos SKY-) */
                                      const _pnAdmin=(item.part_number || item.codigo_publico || ''
                                      ).replace(/^SKY-(PAR|AIR)-/i, '' ); let adminWaMsg='' ; if (isPart) { /* Mensaje
                                      ADMIN → Vendedor de PIEZA */ adminWaMsg='Estimado/a ' + solicitanteNombre
                                      + ', reciba un cordial saludo de parte del equipo de SkyMaster Group.\n\n'
                                      + 'Le escribimos sobre su solicitud para publicar la siguiente pieza en nuestra plataforma:\n\n'
                                      + 'Part Number: ' + _pnAdmin + '\n' + 'Descripción: ' + (item.descripcion
                                      || 'Pieza aeronáutica' ) + '\n' + 'Precio sugerido/interno: $' +
                                      Number(item.precio_interno || 0).toLocaleString('en-US') + ' USD\n\n'
                                      + 'Estamos revisando los datos suministrados para autorizar su publicación. Por favor, indíquenos si podemos proceder o si requiere verificar alguna información adicional. Quedamos atentos.'
                                      ; } else { /* Mensaje ADMIN → Vendedor de AERONAVE */ const
                                      logBooks=item.log_books_url ? 'Sí' : 'No' ; const
                                      historialDanos=item.damage_history_url ? 'Sí' : 'No' ; adminWaMsg='Estimado/a ' +
                                      solicitanteNombre
                                      + ', reciba un cordial saludo de parte del equipo de SkyMaster Group.\n\n'
                                      + 'Le escribimos sobre su solicitud para publicar su aeronave en nuestra plataforma:\n\n'
                                      + 'Registro: ' + (item.codigo_publico || item.modelo || 'N/A' ) + '\n' + 'Año: ' +
                                      (item.anio || 'N/A' ) + ' | Horas Totales: ' + (item.horas_vuelo || 'N/A' ) + '\n'
                                      + 'Horas Motores: ' + (item.horas_motores || 'N/A' ) + ' | Horas Turbinas: ' +
                                      (item.horas_turbinas || 'N/A' ) + '\n' + 'Log Books: ' + logBooks + '\n'
                                      + 'Historial de Daños: ' + historialDanos + '\n' + 'Ubicación: ' + (item.ubicacion
                                      || 'Internacional' ) + '\n' + 'Precio sugerido/interno: $' +
                                      Number(item.precio_interno || 0).toLocaleString('en-US') + ' USD\n\n'
                                      + 'Estamos evaluando la información suministrada para proceder con la publicación. Quisiéramos confirmar algunos detalles técnicos. Quedamos atentos a su respuesta.'
                                      ; } %>
                                      <a href="https://wa.me/<%= vendedorWA %>?text=<%= encodeURIComponent(adminWaMsg) %>"
                                        target="_blank"
                                        class="p-1.5 text-slate-300 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-lg transition-all inline-block"
                                        title="WhatsApp Vendedor">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                          <path
                                            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                                        </svg>
                                      </a>

                                      <!-- Icono 4: Editar Registro -->
                                      <button onclick="openModalForEdit('<%= itemUid %>')"
                                        class="p-1.5 text-slate-300 hover:text-amber-400 hover:bg-amber-500/10 rounded-lg transition-all"
                                        title="Editar Registro">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                      </button>

                                      <!-- Icono 5: Eliminar Registro -->
                                      <button onclick="requestDelete('<%= itemUid %>')"
                                        class="p-1.5 text-slate-300 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-all"
                                        title="Eliminar Registro">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                      </button>
                              </div>
                            </td>
                          </tr>
                          <% }); %>
                            <% } else { %>
                              <tr>
                                <td colspan="8" class="py-12 text-center text-slate-400">
                                  <p class="text-sm font-semibold">No se encontraron registros de inventario
                                    actualmente.</p>
                                </td>
                              </tr>
                              <% } %>

            </tbody>
          </table>
        </div>

        <!-- Barra de Paginación Limpia -->
        <div id="paginationContainer"
          class="bg-slate-900/95 border-t border-slate-700/80 px-4 py-3.5 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="text-xs text-slate-300 flex items-center gap-1.5">
            <span>Mostrando</span>
            <span id="pageStart" class="font-bold text-white">0</span>
            <span>a</span>
            <span id="pageEnd" class="font-bold text-white">0</span>
            <span>de</span>
            <span id="pageTotal" class="font-bold text-amber-400">0</span>
            <span>registros</span>
          </div>

          <div id="paginationNavWrapper" class="flex items-center gap-2">
            <!-- Botón Anterior -->
            <button type="button" id="btnPrevPage" onclick="changePage(currentPage - 1)"
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 border border-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span>Anterior</span>
            </button>

            <!-- Números de Página -->
            <div id="paginationButtons" class="inline-flex items-center gap-1"></div>

            <!-- Botón Siguiente -->
            <button type="button" id="btnNextPage" onclick="changePage(currentPage + 1)"
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 border border-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer">
              <span>Siguiente</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>

    </main>

    <!-- MODAL 1: VER DETALLES COMPLETO (OJITO) -->
    <div id="detailsModal"
      class="fixed inset-0 bg-slate-950/85 backdrop-blur-md hidden items-start justify-center z-[1000] p-4 pt-16 sm:pt-20 pb-10 overflow-y-auto">
      <div
        class="bg-slate-800 border border-slate-700 w-full max-w-4xl rounded-2xl shadow-2xl overflow-hidden my-auto transform transition-all">

        <!-- Header Modal -->
        <div class="bg-slate-900 px-6 py-4 border-b border-slate-700 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span id="detCodigo"
              class="text-xs font-mono font-bold px-3 py-1 bg-amber-500/15 text-amber-300 border border-amber-500/30 rounded-lg"></span>
            <div>
              <h3 id="detTitle" class="text-lg font-bold text-white leading-tight">Detalles del Registro</h3>
              <p id="detSubhead" class="text-xs text-slate-300"></p>
            </div>
          </div>
          <button onclick="closeDetailsModal()"
            class="text-slate-400 hover:text-white text-xl font-bold p-1 cursor-pointer">&times;</button>
        </div>

        <!-- Body Modal Grid -->
        <div class="p-6 space-y-6 text-xs text-slate-200">

          <!-- Ficha Resumen 3 Columnas -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

            <!-- Card 1: Especificaciones Técnicas -->
            <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-700 space-y-2 shadow-sm">
              <div class="flex items-center gap-2 border-b border-slate-700 pb-2 mb-2">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                </svg>
                <h4 class="font-bold text-amber-400 uppercase tracking-wider">Ficha Técnica</h4>
              </div>
              <p><strong class="text-slate-400">Modelo / Item:</strong> <span id="detModeloVal"
                  class="text-white font-semibold"></span></p>
              <p><strong class="text-slate-400">Año de Fabricación:</strong> <span id="detAnio"
                  class="text-white font-semibold"></span></p>
              <p><strong class="text-slate-400">Horas Totales (TTAF):</strong> <span id="detHoras"
                  class="text-white font-semibold"></span></p>
              <p><strong class="text-slate-400">Ubicación Residencial:</strong> <span id="detUbicacion"
                  class="text-white font-semibold"></span></p>
              <div id="detExtraSpecs" class="pt-1 text-slate-300 border-t border-slate-700 mt-1"></div>
            </div>

            <!-- Card 2: Información del Cliente/Vendedor -->
            <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-700 space-y-2 shadow-sm">
              <div class="flex items-center gap-2 border-b border-slate-700 pb-2 mb-2">
                <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <h4 class="font-bold text-sky-400 uppercase tracking-wider">Contacto Vendedor</h4>
              </div>
              <p><strong class="text-slate-400">Nombre Solicitante:</strong> <span id="detSolicitante"
                  class="text-white font-semibold"></span></p>
              <p><strong class="text-slate-400">Teléfono:</strong> <span id="detTelefono"
                  class="text-white font-semibold"></span></p>
              <p><strong class="text-slate-400">Correo Electrónico:</strong> <span id="detCorreo"
                  class="text-white font-semibold"></span></p>
              <div class="pt-2" id="detWhatsappBtn"></div>
            </div>

            <!-- Card 3: Estructura de Precios & Ganancia -->
            <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-700 space-y-2 shadow-sm">
              <div class="flex items-center gap-2 border-b border-slate-700 pb-2 mb-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h4 class="font-bold text-emerald-400 uppercase tracking-wider">Finanzas & Estado</h4>
              </div>
              <p><strong class="text-slate-400">Precio Interno:</strong> $<span id="detPrecioInterno"
                  class="text-white font-bold"></span> USD</p>
              <p><strong class="text-slate-400">Precio Público:</strong> $<span id="detPrecioPublico"
                  class="text-amber-400 font-bold"></span> USD</p>
              <p><strong class="text-slate-400">Ganancia Est.:</strong> $<span id="detGanancia"
                  class="text-emerald-400 font-extrabold text-sm"></span> USD</p>
              <p><strong class="text-slate-400">Estado Actual:</strong> <span id="detEstado"
                  class="font-bold px-2 py-0.5 rounded bg-slate-800 text-amber-400 border border-slate-700"></span></p>
            </div>

          </div>

          <!-- Documentación Adjunta (PDFs) -->
          <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-700">
            <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Documentos Técnicos Adjuntos
              (PDF)</h4>
            <div id="detDocs" class="flex flex-wrap items-center gap-3"></div>
          </div>


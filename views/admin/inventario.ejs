                  <span class="text-[10px] font-bold text-sky-400 uppercase tracking-wider block mb-2">Vistas de Interior / Cabina</span>
                  <div class="flex items-center gap-2 overflow-x-auto pb-1 min-h-[70px]" id="intImages"></div>
                </div>

        // Modal Generar Ficha Técnica PDF
        function openFichaTecnica(uid) {
          const item = findItemByUid(uid);
          if (!item) return;

          const isAircraft = ['aircraft', 'aeronave'].includes(item.tipo || item.item_type);
          const cleanCode = (item.codigo_publico || '').replace(/^SKY-(PAR|AIR)-/i, '');
          const cleanPN = (item.part_number || '').replace(/^SKY-(PAR|AIR)-/i, '');

          document.getElementById('fichaCodigo').innerText = cleanCode || cleanPN;
          document.getElementById('fichaModelo').innerText = isAircraft ? item.modelo : `Part Number: ${cleanPN || cleanCode}`;
          document.getElementById('fichaTipo').innerText = isAircraft ? 'Aeronave Ejecutiva Certificada' : 'Componente / Repuesto Certificado';
          document.getElementById('fichaPrecio').innerText = (item.precio_publico !== null && item.precio_publico !== undefined && item.precio_publico !== '') ? `$${Number(item.precio_publico).toLocaleString('en-US')} USD` : 'Consulte Precio Cotización';
          const certEl = document.getElementById('fichaCertCode');
          if (certEl) certEl.innerText = 'CERT-SM-' + item.id;

          // Metadatos de Hoja Membretada Ejecutiva (Formato numérico DD/MM/YYYY)
          const hoy = new Date();
          const dd = String(hoy.getDate()).padStart(2, '0');
          const mm = String(hoy.getMonth() + 1).padStart(2, '0');
          const yyyy = hoy.getFullYear();
          const fechaStr = `${dd}/${mm}/${yyyy}`;
          const emisionEl = document.getElementById('fichaEmisionFecha');
          if (emisionEl) emisionEl.innerText = fechaStr;

          const solicitanteEl = document.getElementById('fichaSolicitante');
          if (solicitanteEl) solicitanteEl.innerText = item.solicitante || 'Cliente Registrado';

          const contactoEl = document.getElementById('fichaContacto');
          if (contactoEl) contactoEl.innerText = item.contacto || item.vendedor_telefono || 'Dpto. Comercial SkyMaster';

          const correoEl = document.getElementById('fichaCorreo');
          if (correoEl) correoEl.innerText = item.vendedor_correo || item.correo || item.email || 'No registrado';

          const estadoBadgeEl = document.getElementById('fichaEstadoBadge');
          if (estadoBadgeEl) {
            estadoBadgeEl.innerText = item.estado || 'Disponible';
            if (item.estado === 'Vendido') {
              estadoBadgeEl.style.color = '#e11d48';
              estadoBadgeEl.style.background = '#ffe4e6';
              estadoBadgeEl.style.borderColor = '#fecdd3';
            } else if (item.estado === 'En Espera') {
              estadoBadgeEl.style.color = '#d97706';
              estadoBadgeEl.style.background = '#fef3c7';
              estadoBadgeEl.style.borderColor = '#fde68a';
            } else {
              estadoBadgeEl.style.color = '#047857';
              estadoBadgeEl.style.background = '#d1fae5';
              estadoBadgeEl.style.borderColor = '#a7f3d0';
            }
          }

          const estadoTextoEl = document.getElementById('fichaEstadoTexto');
          if (estadoTextoEl) estadoTextoEl.innerText = item.estado || 'En Venta';

          const precioInternoEl = document.getElementById('fichaPrecioInterno');
          if (precioInternoEl) {
            precioInternoEl.innerText = (item.precio_interno !== null && item.precio_interno !== undefined && item.precio_interno !== '')
              ? `$${Number(item.precio_interno).toLocaleString('en-US')} USD`
              : 'Confidencial';
          }

          const gananciaEl = document.getElementById('fichaGanancia');
          if (gananciaEl) {
            if (item.precio_publico && item.precio_interno) {
              const diff = Number(item.precio_publico) - Number(item.precio_interno);
              gananciaEl.innerText = `$${diff.toLocaleString('en-US')} USD`;
              gananciaEl.style.color = diff >= 0 ? '#059669' : '#e11d48';
            } else {
              gananciaEl.innerText = 'En revisión';
              gananciaEl.style.color = '#64748b';
            }
          }

          const descTextEl = document.getElementById('fichaDescText');
          if (descTextEl) {
            descTextEl.innerText = item.descripcion || (isAircraft
              ? 'Aeronave ejecutiva verificada conforme a estándares de mantenimiento aeronáutico SkyMaster. Bitácoras y registro técnico disponibles para inspección pre-compra.'
              : 'Componente aeronáutico certificado conforme a regulaciones técnicas de aviación.');
          }

          // Manejo de imagen en ficha técnica (si tiene múltiples imágenes, mostrar cuadrícula/mosaico compacto; si es pieza sin imagen, mostrar placeholder técnico)
          const fichaImgBox = document.getElementById('fichaImgContainer');
          const allImages = Array.isArray(item.imagenes) && item.imagenes.length > 0
            ? item.imagenes
            : (item.imagen_url ? [item.imagen_url] : (isAircraft ? ['/img/card_sales.jpg'] : []));

          if (fichaImgBox) {
            fichaImgBox.innerHTML = '';

            if (allImages.length > 1) {
              // Múltiples fotografías: Renderizado dinámico de cuadrícula compacta optimizada para PDF
              const gridCols = allImages.length === 2 ? 'repeat(2, 1fr)' : (allImages.length === 3 ? 'repeat(3, 1fr)' : 'repeat(2, 1fr)');
              const gridRows = allImages.length <= 3 ? '1fr' : 'repeat(2, 1fr)';
              const displayedImages = allImages.slice(0, 4);

              const gridDiv = document.createElement('div');
              gridDiv.style.cssText = `display:grid;grid-template-columns:${gridCols};grid-template-rows:${gridRows};gap:4px;width:100%;height:100%;padding:4px;box-sizing:border-box;`;

              displayedImages.forEach(imgUrl => {
                const img = document.createElement('img');
                img.src = imgUrl;
                img.alt = 'Fotografía Registro';
                img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:6px;display:block;';
                gridDiv.appendChild(img);
              });

              fichaImgBox.appendChild(gridDiv);
            } else if (allImages.length === 1) {
              // Imagen única
              const img = document.createElement('img');
              img.id = 'fichaMainImg';
              img.src = allImages[0];
              img.alt = 'Fotografía del Registro';
              img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block;';
              fichaImgBox.appendChild(img);
            } else {
              // Sin fotos (pieza sin imagen): placeholder técnico
              const placeholder = document.createElement('div');
              placeholder.id = 'fichaPartPlaceholder';
              placeholder.className = 'w-full h-full rounded-lg border border-dashed border-slate-300 bg-slate-50 flex flex-col items-center justify-center text-slate-500 p-4 text-center';
              placeholder.innerHTML = `
                <svg class="w-10 h-10 text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766l1.232-.369a2.25 2.25 0 001.503-2.122v-.387a2.25 2.25 0 00-.659-1.591l-.643-.643a2.25 2.25 0 00-1.591-.659h-.387a2.25 2.25 0 00-2.122 1.503l-.369 1.232c-.14.468-.382.891-.766 1.208l-3.03 2.496"/>
                </svg>
                <span class="text-xs font-bold text-slate-700">Pieza / Componente Certificado</span>
                <span class="text-[10px] text-slate-400 mt-1">Registro sin archivo fotográfico</span>
              `;
              fichaImgBox.appendChild(placeholder);
            }
          }

          const specsUl = document.getElementById('fichaSpecs');
          if (isAircraft) {
            specsUl.innerHTML = `
              <li style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Año de Fabricación:</span><strong style="color:#0f172a;">${item.anio || 'N/A'}</strong></li>
              <li style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Horas Totales (TTAF):</span><strong style="color:#0f172a;">${item.horas_vuelo || 0} hrs</strong></li>
              <li style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Horas Motores:</span><strong style="color:#0f172a;">${item.horas_motores || 'N/A'}</strong></li>
              <li style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Horas Turbinas / APU:</span><strong style="color:#0f172a;">${item.horas_turbinas || 'N/A'}</strong></li>
              <li style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Ubicación:</span><strong style="color:#0f172a;">${item.ubicacion || 'Internacional'}</strong></li>
              <li style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Libro de Mantenimiento:</span><strong style="color:#0f172a;">${item.log_books_url ? 'Disponibles (Digital)' : 'No posee libro de mantenimiento'}</strong></li>
              <li style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Historial de Daños:</span><strong style="color:#0f172a;">${item.damage_history_url ? 'Disponibles (Digital)' : 'No posee historial de daños'}</strong></li>
            `;
          } else {
            const pnDisplay = cleanPN || cleanCode;
            specsUl.innerHTML = `
              <li style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Part Number (P/N):</span><strong style="color:#0f172a;font-family:monospace;">${pnDisplay || 'N/A'}</strong></li>
              <li style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;"><span style="color:#64748b;font-weight:600;">Categoría:</span><strong style="color:#0f172a;">Repuesto Certificado</strong></li>
            `;
          }

          const modal = document.getElementById('fichaModal');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }

        function closeFichaModal() {
          const modal = document.getElementById('fichaModal');
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        // Descarga Directa de Ficha Técnica en PDF (Sin ventana emergente de impresión)
        async function descargarFichaPDF() {
          const element = document.getElementById('fichaModalDownloadArea');
          const codigo = (document.getElementById('fichaCodigo').innerText || 'SkyMaster').replace(/[^a-zA-Z0-9_-]/g, '_');
          const btn = document.getElementById('btnDescargarFichaPDF');
          const originalContent = btn ? btn.innerHTML : '';

          if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<svg class="w-4 h-4 animate-spin text-slate-950" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg><span>Generando archivo PDF...</span>`;
          }

          try {
            if (element) {
              element.classList.add('pdf-exporting');
            }

            if (typeof html2pdf !== 'undefined') {
              const opt = {
                margin: [8, 8, 8, 8],
                filename: `Ficha_Tecnica_${codigo}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: {
                  scale: 1.8,
                  useCORS: true,
                  logging: false,
                  backgroundColor: '#ffffff',
                  scrollX: 0,
                  scrollY: 0
                },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak: { mode: 'avoid-all' }
              };

              await html2pdf().set(opt).from(element).save();
            } else {
              // Descarga directa con Blob si no hay conexión al CDN
              const textData = `SKYMASTER EXECUTIVE AVIATION\nFICHA TECNICA DE COTIZACION\nCodigo: ${codigo}\nPrecio: ${document.getElementById('fichaPrecio').innerText}\n${document.getElementById('fichaSpecs').innerText}`;
              const blob = new Blob([textData], { type: 'application/pdf' });
              const link = document.createElement('a');
              link.href = URL.createObjectURL(blob);
              link.download = `Ficha_Tecnica_${codigo}.pdf`;
              link.click();
            }
          } catch (err) {
            console.error('Error al generar PDF directo:', err);
            alert('Hubo un inconveniente al generar el PDF. Por favor, intente nuevamente.');
          } finally {
            if (element) {
              element.classList.remove('pdf-exporting');
            }
            if (btn) {
              btn.disabled = false;
              btn.innerHTML = originalContent;
            }
          }
        }

        // Modal Galería Lightbox (Maneja piezas sin fotos limpiamente)
        function openGalleryModal(uid, selectedImgUrl = null) {
          const item = findItemByUid(uid);
          const isPart = ['part', 'pieza'].includes(item?.tipo || item?.item_type);
          const hasImages = Boolean(item && item.has_custom_images && item.imagenes && item.imagenes.length > 0);

          if (isPart && !hasImages) {
            // Modal personalizado en lugar de alert()
            const modal = document.getElementById('noPhotoModal');
            if (modal) {
              modal.classList.remove('hidden');
              modal.classList.add('flex');
            }
            return;
          }

          const images = hasImages ? item.imagenes : (isAircraft ? [(item ? item.imagen_url : '/img/card_sales.jpg')] : []);

          if (images.length === 0) {
            const modal = document.getElementById('noPhotoModal');
            if (modal) {
              modal.classList.remove('hidden');
              modal.classList.add('flex');
            }
            return;
          }

          const mainImg = document.getElementById('galleryMainImg');
          mainImg.src = selectedImgUrl || images[0];

          const thumbsDiv = document.getElementById('galleryThumbnails');
          thumbsDiv.innerHTML = '';

          images.forEach(url => {
            const thumb = document.createElement('img');
            thumb.src = url;
            thumb.className = `w-16 h-12 object-cover rounded-lg border cursor-pointer ${url === mainImg.src ? 'border-amber-500 scale-105' : 'border-slate-700 opacity-70'}`;
            thumb.onclick = () => {
              mainImg.src = url;
              document.querySelectorAll('#galleryThumbnails img').forEach(t => t.className = 'w-16 h-12 object-cover rounded-lg border border-slate-700 opacity-70');
              thumb.className = 'w-16 h-12 object-cover rounded-lg border border-amber-500 scale-105';
            };
            thumbsDiv.appendChild(thumb);
          });

          const modal = document.getElementById('galleryModal');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }


    <!-- Inclusión de Footer -->
    <%- include('../partials/footer') %>

      <!-- Script JSON seguro que no rompe el resaltador EJS/JS -->
      <script id="inventory-data-script" type="application/json">
        <%- JSON.stringify(typeof inventory !== 'undefined' ? inventory : []) %>
      </script>

      <!-- Scripts de Control e Interacción -->
      <script>
        // Parsear data de forma limpia sin syntax error
        const inventoryData = JSON.parse(document.getElementById('inventory-data-script').textContent || '[]');

        let deleteTargetUid = null;

        document.addEventListener('DOMContentLoaded', () => {
          sortRowsByMostRecent();
          updateActiveCounts();
          filterInventory();
        });

        // Ordenar registros por los más recientes primero (ID descendente)
        function sortRowsByMostRecent() {
          const tbody = document.getElementById('inventoryTableBody');
          if (!tbody) return;
          const rows = Array.from(tbody.querySelectorAll('.inventory-row'));
          rows.sort((a, b) => {
            const idA = parseInt(a.dataset.id || '0', 10);
            const idB = parseInt(b.dataset.id || '0', 10);
            return idB - idA;
          });
          rows.forEach(r => tbody.appendChild(r));
        }

        // Buscar item único por UID (ej: aircraft_1 o part_1)
        function findItemByUid(uid) {
          return inventoryData.find(i => (i.uid === uid) || (i.tipo + '_' + i.id === uid));
        }

        // Guardar precio público asignado por el admin
        async function savePrecioPublico(uid, value) {
          const item = findItemByUid(uid);
          if (!item) return;

          const numValue = value !== '' ? parseFloat(value) : null;
          const gananciaElem = document.getElementById('ganancia-' + uid);

          item.precio_publico = numValue;
          if (numValue !== null && !isNaN(numValue)) {
            const ganancia = numValue - (item.precio_interno || 0);
            if (gananciaElem) {
              gananciaElem.innerHTML = `<span class="${ganancia >= 0 ? 'text-emerald-400' : 'text-rose-400'}">$${ganancia.toLocaleString('en-US')}</span>`;
            }
          } else {
            if (gananciaElem) gananciaElem.innerHTML = `<span class="text-slate-500 text-[10px] italic">En espera de precio</span>`;
          }

          // Actualizar estado del botón publicar en tiempo real
          handlePrecioPublicoLiveChange(uid, value);

          try {
            await fetch('/sales/admin/inventario/' + item.id + '/precio_publico', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: item.id, tipo: item.tipo, precio_publico: numValue })
            });
          } catch (err) {
            console.warn('Error al guardar precio público:', err);
          }
        }

        // Cambio en vivo del input de precio público en la tabla
        function handlePrecioPublicoLiveChange(uid, value) {
          const item = findItemByUid(uid);
          const num = parseFloat(value);
          const isValid = !isNaN(num) && num > 0;
          if (item) item.precio_publico = isValid ? num : null;

          const pubBtn = document.getElementById('pub-btn-' + uid);
          if (pubBtn) {
            pubBtn.dataset.enabled = isValid ? 'true' : 'false';
            if (isValid) {
              pubBtn.className = 'inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded transition-all shadow-sm bg-emerald-500/20 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 border border-emerald-500/40 cursor-pointer';
              pubBtn.title = 'Publicar directamente en catálogo';
            } else {
              pubBtn.className = 'inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded transition-all shadow-sm bg-slate-800/80 text-slate-500 border border-slate-700/60 opacity-50 cursor-not-allowed';
              pubBtn.title = 'Bloqueado: Debe asignar un Precio Público antes de publicar';
            }
          }
        }

        // Clic en botón "Publicar" con validación estricta
        function handlePublishClick(uid) {
          const item = findItemByUid(uid);
          const priceInput = document.getElementById('precio-publico-' + uid);
          const currentPrice = priceInput && priceInput.value !== '' ? parseFloat(priceInput.value) : (item ? parseFloat(item.precio_publico) : NaN);

          if (isNaN(currentPrice) || currentPrice <= 0) {
            alert('⚠️ Acción Bloqueada: Ninguna aeronave o pieza puede publicarse si no tiene asignado un "Precio Público". Por favor, asigne un precio antes de continuar.');
            if (priceInput) {
              priceInput.focus();
              priceInput.classList.add('ring-2', 'ring-rose-500');
              setTimeout(() => priceInput.classList.remove('ring-2', 'ring-rose-500'), 2500);
            }
            return;
          }

          updateRowStatus(uid, 'En Venta');
        }

        // Modales de Creación y Edición
        function openModal(mode) {
          const modal = document.getElementById('itemModal');
          const title = document.getElementById('modalTitle');
          const form = document.getElementById('inventoryForm');

          if (mode === 'create') {
            title.innerText = 'Nueva Publicación de Inventario';
            document.getElementById('modalModeTag').innerText = 'MODO: NUEVO REGISTRO';
            form.reset();
            form.action = '/sales/admin/inventario/guardar';
            document.getElementById('itemId').value = '';
            document.getElementById('itemTipoHidden').value = 'aeronave';
            document.getElementById('modalTipo').disabled = false;
            document.getElementById('modalTipo').value = 'aeronave';
            document.getElementById('modalEstado').value = 'En Espera';
            document.getElementById('modalCurrentLogBooks').innerText = '';
            document.getElementById('modalCurrentDamage').innerText = '';
            toggleFieldsByTipo();
            recalcModalProfit();
          }
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          // Restablecer scroll al inicio cada vez que se abre el modal para garantizar visibilidad completa de la cabecera
          modal.scrollTop = 0;
          const formEl = document.getElementById('inventoryForm');
          if (formEl) formEl.scrollTop = 0;
        }

        function openModalForEdit(uid) {
          const item = findItemByUid(uid);
          if (!item) return;

          openModal('edit');
          const isAircraft = ['aircraft', 'aeronave'].includes(item.tipo || item.item_type);
          const cleanCode = (item.codigo_publico || '').replace(/^SKY-(PAR|AIR)-/i, '');
          const cleanPN = (item.part_number || '').replace(/^SKY-(PAR|AIR)-/i, '');

          document.getElementById('modalTitle').innerText = isAircraft
            ? 'Editar Aeronave: ' + (item.modelo || cleanCode)
            : 'Editar Pieza: ' + (cleanPN || cleanCode || item.modelo);
          document.getElementById('modalModeTag').innerText = 'REF ID: #' + item.id + ' • ' + (cleanCode || cleanPN);
          document.getElementById('inventoryForm').action = '/sales/admin/inventario/' + item.id + '/edit';

          document.getElementById('itemId').value = item.id;
          document.getElementById('itemTipoHidden').value = item.tipo || (isAircraft ? 'aircraft' : 'part');
          document.getElementById('modalTipo').value = isAircraft ? 'aeronave' : 'pieza';
          document.getElementById('modalTipo').disabled = true; // El tipo no se transmuta en edición

          // Campos aeronave
          document.getElementById('modalModelo').value = item.modelo || '';
          document.getElementById('modalAnio').value = item.anio || '';
          document.getElementById('modalHoras').value = item.horas_vuelo || '';
          document.getElementById('modalHorasMotores').value = item.horas_motores || '';
          document.getElementById('modalHorasTurbinas').value = item.horas_turbinas || '';
          document.getElementById('modalUbicacion').value = item.ubicacion || '';

          // Campos pieza
          document.getElementById('modalPartNumber').value = cleanPN || item.part_number || item.codigo_publico || '';
          document.getElementById('modalDescripcion').value = item.descripcion || '';

          // Vendedor / Contacto
          document.getElementById('modalVendedorNombre').value = item.vendedor_nombre || item.solicitante || '';
          document.getElementById('modalVendedorApellido').value = item.vendedor_apellido || '';
          document.getElementById('modalVendedorTelefono').value = item.vendedor_telefono || '';
          document.getElementById('modalVendedorCorreo').value = item.vendedor_correo || '';

          // Precios & Estado
          document.getElementById('modalPrecioInterno').value = item.precio_interno || 0;
          document.getElementById('modalPrecioPublico').value = item.precio_publico !== null && item.precio_publico !== undefined ? item.precio_publico : '';
          document.getElementById('modalEstado').value = item.estado || 'En Espera';

          // Documentos actuales
          const currentLogBooks = document.getElementById('modalCurrentLogBooks');
          if (item.log_books_url) {
            currentLogBooks.innerHTML = `<a href="${item.log_books_url}" target="_blank" class="text-red-400 hover:underline">📄 Ver actual</a>`;
          } else {
            currentLogBooks.innerText = 'Sin archivo adjunto';
          }

          const currentDamage = document.getElementById('modalCurrentDamage');
          if (item.damage_history_url) {

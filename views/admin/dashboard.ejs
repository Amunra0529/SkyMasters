<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Dashboard Ejecutivo | SkyMaster Admin' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <!-- Chart.js para visualización de métricas aeronáuticas -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <style>
    /* ===================================================
       ESTILOS DEL DASHBOARD EJECUTIVO (DIONKEL)
       Alineado con el Design System de SkyMaster
       =================================================== */
    .dashboard-wrapper {
      padding: 2.2rem 2rem 4rem;
      max-width: 1440px;
      margin: 0 auto;
      width: 100%;
    }

    /* Header del Dashboard */
    .dash-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1.5rem;
      margin-bottom: 2.2rem;
      flex-wrap: wrap;
    }

    .dash-title-box h1 {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .dash-title-box h1 span.gold-text {
      color: var(--accent-gold);
    }

    .dash-subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-top: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .dash-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: #34d399;
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-full);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background-color: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 10px #10b981;
      animation: pulseAnim 2s infinite ease-in-out;
    }

    @keyframes pulseAnim {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.4); opacity: 0.6; }
    }

    .dash-actions-group {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      flex-wrap: wrap;
    }

    .dash-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: linear-gradient(135deg, #c5a059 0%, #d8b46e 100%);
      color: #070d1e;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-sm);
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(197, 160, 89, 0.35);
      transition: all 0.25s ease;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .dash-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(197, 160, 89, 0.5);
    }

    .dash-btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--surface-navy);
      color: var(--text-main);
      font-weight: 600;
      font-size: 0.85rem;
      padding: 0.75rem 1.2rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--card-border);
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .dash-btn-secondary:hover {
      background: var(--card-bg);
      border-color: rgba(197, 160, 89, 0.4);
      color: var(--accent-gold);
    }

    /* Grid de KPIs Superiores */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2.2rem;
    }

    .kpi-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 1.4rem 1.35rem;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: transparent;
      transition: background 0.3s ease;
    }

    .kpi-card:hover {
      transform: translateY(-3px);
      border-color: rgba(197, 160, 89, 0.35);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
    }

    .kpi-card:hover::before {
      background: linear-gradient(90deg, var(--accent-gold), var(--accent-cyan));
    }

    .kpi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.85rem;
    }

    .kpi-title {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .kpi-icon-wrap {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.04);
      color: var(--accent-gold);
    }

    .kpi-value {
      font-size: 1.9rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.15;
      font-family: var(--font-display);
      margin-bottom: 0.45rem;
    }

    .kpi-footer {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--text-dim);
    }

    .kpi-badge-positive {
      color: #34d399;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
    }

    .kpi-badge-neutral {
      color: var(--accent-cyan);
      font-weight: 600;
    }

    /* Sección de Analíticas y Gráficos */
    .analytics-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
      margin-bottom: 2.2rem;
    }

    .chart-panel {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 1.6rem;
      position: relative;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.4rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .panel-title {
      font-size: 1.12rem;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .panel-title-tag {
      font-size: 0.72rem;
      padding: 0.15rem 0.55rem;
      border-radius: 4px;
      background: rgba(56, 189, 248, 0.15);
      color: var(--accent-cyan);
      font-weight: 600;
    }

    .chart-toggle-group {
      display: flex;
      background: var(--surface-navy);
      padding: 3px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--card-border);
    }

    .chart-toggle-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .chart-toggle-btn.active {
      background: var(--primary-navy);
      color: var(--accent-gold);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }

    .chart-container-main {
      position: relative;
      height: 290px;
      width: 100%;
    }

    .chart-container-pie {
      position: relative;
      height: 230px;
      width: 100%;
    }

    .pie-legend-custom {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 1.1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 0.9rem;
    }

    .legend-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 0.45rem;
    }

    /* Sección Principal: Tabla de Operaciones + Alertas */
    .operations-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
      margin-bottom: 2.2rem;
    }

    .table-panel {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 1.6rem;
      overflow-x: auto;
    }

    .dash-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.86rem;
    }

    .dash-table th {
      padding: 0.85rem 1rem;
      background: rgba(7, 13, 30, 0.6);
      color: var(--text-muted);
      font-size: 0.76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid var(--card-border);
    }

    .dash-table th:first-child { border-top-left-radius: 8px; }
    .dash-table th:last-child { border-top-right-radius: 8px; }

    .dash-table td {
      padding: 0.95rem 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: var(--text-main);
      vertical-align: middle;
    }

    .dash-table tbody tr {
      transition: background 0.2s ease;
    }

    .dash-table tbody tr:hover {
      background: rgba(255, 255, 255, 0.025);
    }

    .flight-badge {
      font-family: monospace;
      font-weight: 700;
      color: var(--accent-gold);
      background: rgba(197, 160, 89, 0.12);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.78rem;
      display: inline-block;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .status-in_flight {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .status-confirmed {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status-pending {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .status-completed {
      background: rgba(148, 163, 184, 0.15);
      color: #cbd5e1;
      border: 1px solid rgba(148, 163, 184, 0.3);
    }

    /* Alertas y Acciones */
    .alerts-panel {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 1.6rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .alert-card {
      background: var(--surface-navy);
      border-left: 3px solid var(--accent-gold);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      padding: 0.9rem 1rem;
      margin-bottom: 0.95rem;
      transition: transform 0.2s ease;
    }

    .alert-card:hover {
      transform: translateX(3px);
    }

    .alert-card.critical {
      border-left-color: var(--status-danger);
    }

    .alert-card.warning {
      border-left-color: var(--status-warning);
    }

    .alert-card.info {
      border-left-color: var(--accent-cyan);
    }

    .alert-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.3rem;
    }

    .alert-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .alert-card.critical .alert-badge { color: #f87171; }
    .alert-card.warning .alert-badge { color: #fbbf24; }
    .alert-card.info .alert-badge { color: #38bdf8; }

    .alert-time {
      font-size: 0.72rem;
      color: var(--text-dim);
    }

    .alert-title {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.25rem;
    }

    .alert-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Hub de Reportes Ejecutivos (Especialidad de Dionkel) */
    .reports-hub {
      background: linear-gradient(135deg, rgba(15, 28, 63, 0.9) 0%, rgba(7, 13, 30, 0.95) 100%);
      border: 1px solid rgba(197, 160, 89, 0.3);
      border-radius: var(--radius-lg);
      padding: 2.2rem;
      margin-bottom: 2.2rem;
      position: relative;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    }

    .reports-hub-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.6rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .reports-hub-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .reports-hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
    }

    .report-action-card {
      background: rgba(17, 30, 66, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      padding: 1.4rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
    }

    .report-action-card:hover {
      border-color: var(--accent-gold);
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      background: rgba(21, 36, 79, 0.85);
    }

    .report-icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      background: rgba(197, 160, 89, 0.15);
      color: var(--accent-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }

    .report-card-title {
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.4rem;
    }

    .report-card-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.45;
      margin-bottom: 1.25rem;
    }

    .report-download-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: var(--surface-navy);
      color: var(--accent-gold);
      border: 1px solid rgba(197, 160, 89, 0.4);
      padding: 0.65rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .report-download-btn:hover {
      background: var(--accent-gold);
      color: #070d1e;
    }

    /* Modal de Reportes */
    .report-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(7, 13, 30, 0.85);
      backdrop-filter: blur(8px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .report-modal.active {
      display: flex;
    }

    .modal-box {
      background: var(--card-bg);
      border: 1px solid rgba(197, 160, 89, 0.4);
      border-radius: var(--radius-lg);
      max-width: 580px;
      width: 100%;
      padding: 2rem;
      position: relative;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
      animation: modalFadeIn 0.25s ease-out;
    }

    @keyframes modalFadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    .modal-close-btn {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.4rem;
      cursor: pointer;
      line-height: 1;
    }

    .modal-close-btn:hover { color: var(--accent-gold); }

    /* Responsive */
    @media (max-width: 1080px) {
      .analytics-grid,
      .operations-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .dashboard-wrapper {
        padding: 1.5rem 1rem 3rem;
      }
      .dash-title-box h1 {
        font-size: 1.6rem;
      }
      .kpi-value {
        font-size: 1.6rem;
      }
      .dash-actions-group {
        width: 100%;
      }
      .dash-btn-primary, .dash-btn-secondary {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <!-- Inclusión de Barra de Navegación Administrativa -->
  <%- include('../partials/navbar_admin') %>

  <!-- ========================================================
       CENTRO DE MANDO Y DASHBOARD EJECUTIVO (DIONKEL)
       ======================================================== -->
  <main class="dashboard-wrapper">

    <!-- 1. Header del Dashboard -->
    <header class="dash-header">
      <div class="dash-title-box">
        <h1>
          Centro de Mando <span class="gold-text">SkyMaster</span>
        </h1>
        <div class="dash-subtitle">
          <span>Bienvenido, <strong><%= typeof user !== 'undefined' && user.name ? user.name : 'Dionkel' %></strong> (Dirección de Control & Analíticas)</span>
          <span class="dash-status-pill">
            <span class="pulse-dot"></span> Red Operacional Activa &bull; ADS-B Online
          </span>
        </div>
      </div>

      <div class="dash-actions-group">
        <button class="dash-btn-secondary" onclick="window.location.reload()" title="Refrescar métricas">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
          </svg>
          Sincronizar
        </button>

        <button class="dash-btn-primary" onclick="openReportModal()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          Exportar Reporte PDF
        </button>
      </div>
    </header>

    <!-- 2. Ribbon de Indicadores Clave de Rendimiento (KPIs) -->
    <section class="kpi-grid">
      <!-- KPI 1: Ingresos Proyectados -->
      <article class="kpi-card">
        <div class="kpi-top">
          <span class="kpi-title">Ingresos Brutos Estimados</span>
          <div class="kpi-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
        </div>
        <div class="kpi-value">
          $<%= (metrics.monthlyRevenue / 1000000).toFixed(2) %>M
        </div>
        <div class="kpi-footer">
          <span class="kpi-badge-positive">&uarr; <%= metrics.monthlyRevenueGrowth %></span>
          <span>vs trimestre anterior</span>
        </div>
      </article>

      <!-- KPI 2: Valuación de Flota e Inventario -->
      <article class="kpi-card">
        <div class="kpi-top">
          <span class="kpi-title">Valuación de Flota</span>
          <div class="kpi-icon-wrap" style="color: var(--accent-cyan);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
            </svg>
          </div>
        </div>
        <div class="kpi-value">
          $<%= (metrics.fleetValue / 1000000).toFixed(0) %>M
        </div>
        <div class="kpi-footer">
          <span class="kpi-badge-neutral"><%= metrics.totalAircrafts %> Naves</span>
          <span>en catálogo e inventario</span>
        </div>
      </article>

      <!-- KPI 3: Misiones Charters Activas -->
      <article class="kpi-card">
        <div class="kpi-top">
          <span class="kpi-title">Operaciones Charter</span>
          <div class="kpi-icon-wrap" style="color: #34d399;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
        </div>
        <div class="kpi-value">
          <%= metrics.activeCharters %> Vuelos
        </div>
        <div class="kpi-footer">
          <span class="kpi-badge-positive"><%= metrics.pendingQuotes %> Solicitudes</span>
          <span>VIP por confirmar</span>
        </div>
      </article>

      <!-- KPI 4: Horas de Vuelo & Confiabilidad -->
      <article class="kpi-card">
        <div class="kpi-top">
          <span class="kpi-title">Horas Voladas (YTD)</span>
          <div class="kpi-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
        </div>
        <div class="kpi-value">
          <%= Number(metrics.flightHoursTotal).toLocaleString() %> h
        </div>
        <div class="kpi-footer">
          <span class="kpi-badge-positive"><%= metrics.onTimeDeparture %> OTP</span>
          <span>puntualidad de salida</span>
        </div>
      </article>

      <!-- KPI 5: Candidatos y Tripulaciones -->
      <article class="kpi-card">
        <div class="kpi-top">
          <span class="kpi-title">Bolsa de Talento</span>
          <div class="kpi-icon-wrap" style="color: #f59e0b;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
        </div>
        <div class="kpi-value">
          <%= metrics.pendingCandidates %> Postulantes
        </div>
        <div class="kpi-footer">
          <span class="kpi-badge-neutral"><%= metrics.totalCandidates %> Evaluados</span>
          <span>en proceso de filtros</span>
        </div>
      </article>
    </section>

    <!-- 3. Gráficas y Data Visualizations (Chart.js) -->
    <section class="analytics-grid">
      <!-- Gráfica Principal: Tendencias de Horas de Vuelo y Facturación -->
      <div class="chart-panel">
        <div class="panel-header">
          <div>
            <h2 class="panel-title">
              Tendencia Operacional Anual
              <span class="panel-title-tag">2026 Live Data</span>
            </h2>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.2rem;">
              Evolución mensual de horas bloque y facturación de servicios charter ejecutivos
            </p>
          </div>
          <div class="chart-toggle-group">
            <button class="chart-toggle-btn active" id="btn-show-hours" onclick="switchChartDataset('hours')">Horas de Vuelo</button>
            <button class="chart-toggle-btn" id="btn-show-revenue" onclick="switchChartDataset('revenue')">Ingresos ($M USD)</button>
          </div>
        </div>
        <div class="chart-container-main">
          <canvas id="mainOperationsChart"></canvas>
        </div>
      </div>

      <!-- Gráfica Secundaria: Segmentación de Flota -->
      <div class="chart-panel">
        <div class="panel-header">
          <h2 class="panel-title">
            Composición de Flota
          </h2>
          <span style="font-size: 0.78rem; color: var(--accent-gold); font-weight: 600;">Disponibilidad 98.6%</span>
        </div>
        <div class="chart-container-pie">
          <canvas id="fleetCompositionChart"></canvas>
        </div>
        <div class="pie-legend-custom">
          <div class="legend-item">
            <span><span class="legend-dot" style="background: #c5a059;"></span>Heavy Jets (G650ER)</span>
            <strong>40%</strong>
          </div>
          <div class="legend-item">
            <span><span class="legend-dot" style="background: #38bdf8;"></span>Ultra Long Range (Global 7500)</span>
            <strong>25%</strong>
          </div>
          <div class="legend-item">
            <span><span class="legend-dot" style="background: #10b981;"></span>Super Mid-Size & Light</span>
            <strong>30%</strong>
          </div>
          <div class="legend-item">
            <span><span class="legend-dot" style="background: #f59e0b;"></span>Turboprops & STOL</span>
            <strong>5%</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Radar de Misiones Recientes + Alertas Operativas -->
    <section class="operations-grid">
      <!-- Tabla de Vuelos Charters Recientes -->
      <div class="table-panel">
        <div class="panel-header">
          <div>
            <h2 class="panel-title">
              Monitoreo de Misiones & Charters
            </h2>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.2rem;">
              Coordinación con el módulo de vuelos charter de Jesus
            </p>
          </div>
          <a href="/admin/operaciones" class="dash-btn-secondary" style="font-size: 0.78rem; padding: 0.45rem 0.85rem;">
            Ver Todas las Operaciones &rarr;
          </a>
        </div>

        <table class="dash-table">
          <thead>
            <tr>
              <th>Misión / Código</th>
              <th>Cliente VIP</th>
              <th>Ruta (Origen &rarr; Destino)</th>
              <th>Aeronave</th>
              <th>Pasajeros</th>
              <th>Estatus</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof recentCharters !== 'undefined' && recentCharters.length > 0) { %>
              <% recentCharters.forEach(flight => { %>
                <tr>
                  <td>
                    <span class="flight-badge"><%= flight.flight_code || ('SKM-' + flight.id) %></span>
                  </td>
                  <td>
                    <strong><%= flight.client_name %></strong>
                    <div style="font-size: 0.74rem; color: var(--text-dim);"><%= flight.client_email %></div>
                  </td>
                  <td>
                    <span style="color: #ffffff; font-weight: 600;"><%= flight.origin %></span>
                    <span style="color: var(--accent-gold); margin: 0 4px;">&rarr;</span>
                    <span style="color: #ffffff; font-weight: 600;"><%= flight.destination %></span>
                  </td>
                  <td><%= flight.aircraft_type %></td>
                  <td><%= flight.passengers %> Pax</td>
                  <td>
                    <% let statusClass = 'status-' + flight.status; %>
                    <span class="status-pill <%= statusClass %>">
                      <% if (flight.status === 'in_flight') { %> ✈️ En Vuelo <% } %>
                      <% if (flight.status === 'confirmed') { %> ✓ Confirmado <% } %>
                      <% if (flight.status === 'pending') { %> ⏳ Cotización <% } %>
                      <% if (flight.status === 'completed') { %> • Completado <% } %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  No hay operaciones registradas actualmente en la base de datos.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Panel Lateral: Alertas Técnicas & Accesos Rápidos -->
      <div class="alerts-panel">
        <div>
          <div class="panel-header">
            <h2 class="panel-title">Alertas Operacionales</h2>
            <span class="dash-status-pill" style="font-size: 0.7rem; padding: 0.15rem 0.5rem;">FBO Caracas / Miami</span>
          </div>

          <% if (typeof alerts !== 'undefined' && alerts.length > 0) { %>
            <% alerts.forEach(al => { %>
              <div class="alert-card <%= al.type %>">
                <div class="alert-top">
                  <span class="alert-badge"><%= al.badge %></span>
                  <span class="alert-time"><%= al.time %></span>
                </div>
                <div class="alert-title"><%= al.title %></div>
                <div class="alert-desc"><%- al.desc %></div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Accesos directos a módulos de compañeros -->
        <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 1.2rem; margin-top: 1rem;">
          <div style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700; margin-bottom: 0.8rem; letter-spacing: 0.05em;">
            Accesos de Gestión Integral
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
            <a href="/admin/inventario" class="dash-btn-secondary" style="justify-content: center; font-size: 0.78rem; padding: 0.55rem;">
              ✈️ Inventario
            </a>
            <a href="/admin/candidatos" class="dash-btn-secondary" style="justify-content: center; font-size: 0.78rem; padding: 0.55rem;">
              👨‍✈️ Candidatos
            </a>
            <a href="/admin/operaciones" class="dash-btn-secondary" style="justify-content: center; font-size: 0.78rem; padding: 0.55rem;">
              🌐 Vuelos
            </a>
            <a href="/admin/configuracion" class="dash-btn-secondary" style="justify-content: center; font-size: 0.78rem; padding: 0.55rem;">
              ⚙️ Respaldos
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Hub de Reportes Ejecutivos en PDF (Responsabilidad Directa de Dionkel) -->
    <section class="reports-hub">
      <div class="reports-hub-header">
        <div>
          <h2 class="reports-hub-title">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            Generador Oficial de Reportes en PDF & Auditoría
          </h2>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.35rem;">
            Módulo asignado a Dionkel: Exportación de documentos corporativos con firma digital y cumplimiento aeronáutico.
          </p>
        </div>
      </div>

      <div class="reports-hub-grid">
        <!-- Reporte 1: Operaciones -->
        <article class="report-action-card">
          <div>
            <div class="report-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="report-card-title">Bitácora & Operaciones Charters</h3>
            <p class="report-card-desc">
              Manifiesto consolidado de misiones ejecutivas, pasajeros transportados y métricas OTP de puntualidad.
            </p>
          </div>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/admin/reportes/pdf/operaciones?format=download" class="report-download-btn" style="flex: 1;">
              📥 Descargar .PDF
            </a>
            <button class="dash-btn-secondary" onclick="openReportModalWith('operaciones')" style="padding: 0.65rem 0.8rem; font-size: 0.78rem;" title="Filtrar y Membrete">
              ⚙️ Filtrar
            </button>
          </div>
        </article>

        <!-- Reporte 2: Inventario -->
        <article class="report-action-card">
          <div>
            <div class="report-icon" style="color: var(--accent-cyan); background: rgba(56, 189, 248, 0.15);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
              </svg>
            </div>
            <h3 class="report-card-title">Inventario & Valuación de Flota</h3>
            <p class="report-card-desc">
              Avalúo comercial de aeronaves disponibles, motores en stock, horas totales e inspecciones AOG.
            </p>
          </div>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/admin/reportes/pdf/inventario?format=download" class="report-download-btn" style="flex: 1;">
              📥 Descargar .PDF
            </a>
            <button class="dash-btn-secondary" onclick="openReportModalWith('inventario')" style="padding: 0.65rem 0.8rem; font-size: 0.78rem;" title="Filtrar y Membrete">
              ⚙️ Filtrar
            </button>
          </div>
        </article>

        <!-- Reporte 3: Talento -->
        <article class="report-action-card">
          <div>
            <div class="report-icon" style="color: #34d399; background: rgba(16, 185, 129, 0.15);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
              </svg>
            </div>
            <h3 class="report-card-title">Auditoría de Candidatos & Tripulaciones</h3>
            <p class="report-card-desc">
              Informe de reclutamiento para pilotos de mando, primeros oficiales y técnicos especialistas.
            </p>
          </div>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/admin/reportes/pdf/candidatos?format=download" class="report-download-btn" style="flex: 1;">
              📥 Descargar .PDF
            </a>
            <button class="dash-btn-secondary" onclick="openReportModalWith('candidatos')" style="padding: 0.65rem 0.8rem; font-size: 0.78rem;" title="Filtrar y Membrete">
              ⚙️ Filtrar
            </button>
          </div>
        </article>

        <!-- Reporte 4: Financiero -->
        <article class="report-action-card">
          <div>
            <div class="report-icon" style="color: #f59e0b; background: rgba(245, 158, 11, 0.15);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="report-card-title">Consolidado Financiero Q3 2026</h3>
            <p class="report-card-desc">
              Rendimiento de fletes por hora, comisiones de compra/venta y costos operacionales en hangares.
            </p>
          </div>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/admin/reportes/pdf/financiero?format=download" class="report-download-btn" style="flex: 1;">
              📥 Descargar .PDF
            </a>
            <button class="dash-btn-secondary" onclick="openReportModalWith('financiero')" style="padding: 0.65rem 0.8rem; font-size: 0.78rem;" title="Filtrar y Membrete">
              ⚙️ Filtrar
            </button>
          </div>
        </article>
      </div>
    </section>

  </main>

  <!-- ========================================================
       MODAL AVANZADO DE GENERACIÓN Y FILTROS DE REPORTES PDF (DIONKEL)
       ======================================================== -->
  <div class="report-modal" id="reportModal">
    <div class="modal-box" style="max-width: 650px;">
      <button class="modal-close-btn" onclick="closeReportModal()">&times;</button>
      <h3 style="font-size: 1.35rem; font-weight: 800; color: #ffffff; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.6rem;">
        <span style="color: var(--accent-gold);">📄</span> Generar Reporte Corporativo Oficial
      </h3>
      <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1.4rem;">
        Personaliza los membretes institucionales de cliente y aplica filtros de fecha y estatus para auditoría:
      </p>

      <form id="reportForm" onsubmit="handleExportPDF(event)">
        <!-- Selector de Tipo de Reporte -->
        <div style="margin-bottom: 1.1rem;">
          <label style="display: block; font-size: 0.76rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 0.35rem;">
            1. Módulo del Reporte Oficial:
          </label>
          <select id="reportSelect" onchange="updateModalStatusOptions()" style="width: 100%; background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.7rem 0.9rem; border-radius: var(--radius-sm); font-family: inherit; font-size: 0.88rem;">
            <option value="operaciones">✈️ Bitácora y Operaciones Charters (Jesus)</option>
            <option value="inventario">🛩️ Inventario & Avalúo de Flota (Morao)</option>
            <option value="candidatos">👨‍✈️ Bolsa de Talento & Postulantes (Osuna)</option>
            <option value="financiero">💼 Consolidado Financiero Q3 2026 (Dionkel)</option>
          </select>
        </div>

        <!-- Membrete de Cliente / Empresa Receptora -->
        <div style="background: rgba(7, 13, 30, 0.5); border: 1px solid rgba(197, 160, 89, 0.25); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.1rem;">
          <div style="font-size: 0.76rem; text-transform: uppercase; color: var(--accent-gold); font-weight: 700; margin-bottom: 0.7rem; display: flex; align-items: center; gap: 0.4rem;">
            <span>🏢</span> 2. Membrete de la Entidad o Cliente Receptor:
          </div>
          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.75rem;">
            <div>
              <label style="display: block; font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.25rem;">Nombre de Empresa / Cliente VIP:</label>
              <input type="text" id="reportEntity" placeholder="Ej: Consorcio Andino Corp / Uso Interno" style="width: 100%; background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.55rem 0.75rem; border-radius: 4px; font-family: inherit; font-size: 0.82rem;">
            </div>
            <div>
              <label style="display: block; font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.25rem;">RIF / ID Fiscal:</label>
              <input type="text" id="reportTaxId" placeholder="Ej: J-40891234-0" style="width: 100%; background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.55rem 0.75rem; border-radius: 4px; font-family: inherit; font-size: 0.82rem;">
            </div>
          </div>
        </div>

        <!-- Filtros de Fecha y Estatus -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; margin-bottom: 1.1rem;">
          <div>
            <label style="display: block; font-size: 0.76rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 0.35rem;">
              3. Periodo de Auditoría:
            </label>
            <select id="reportPeriodQuick" onchange="handlePeriodQuickChange()" style="width: 100%; background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.65rem 0.8rem; border-radius: var(--radius-sm); font-family: inherit; font-size: 0.82rem; margin-bottom: 0.5rem;">
              <option value="all">Todo el Histórico</option>
              <option value="last_30_days">Últimos 30 Días</option>
              <option value="q3_2026">Trimestre Q3 2026</option>
              <option value="custom">Rango Personalizado...</option>
            </select>
            <div id="customDateRange" style="display: none; grid-template-columns: 1fr 1fr; gap: 0.4rem;">
              <input type="date" id="reportStartDate" style="background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.45rem; border-radius: 4px; font-size: 0.75rem; font-family: inherit;">
              <input type="date" id="reportEndDate" style="background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.45rem; border-radius: 4px; font-size: 0.75rem; font-family: inherit;">
            </div>
          </div>

          <div>
            <label style="display: block; font-size: 0.76rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 0.35rem;">
              4. Filtro de Estatus:
            </label>
            <select id="reportStatus" style="width: 100%; background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.65rem 0.8rem; border-radius: var(--radius-sm); font-family: inherit; font-size: 0.82rem;">
              <option value="all">Todos los Registros</option>
              <option value="in_flight">En Vuelo (Activos)</option>
              <option value="confirmed">Confirmados</option>
              <option value="pending">Pendientes / Cotización</option>
              <option value="completed">Completados</option>
            </select>
          </div>
        </div>

        <!-- Salvedades / Notas Oficiales -->
        <div style="margin-bottom: 1.2rem;">
          <label style="display: block; font-size: 0.76rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 0.35rem;">
            5. Observaciones Oficiales al Pie (Opcional):
          </label>
          <input type="text" id="reportNotes" placeholder="Ej: Documento certificado para auditoría preliminar de junta directiva." style="width: 100%; background: var(--surface-navy); border: 1px solid var(--card-border); color: #ffffff; padding: 0.55rem 0.75rem; border-radius: 4px; font-family: inherit; font-size: 0.82rem;">
        </div>

        <!-- Formato de Salida -->
        <div style="margin-bottom: 1.5rem; background: var(--surface-navy); padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--card-border);">
          <label style="display: block; font-size: 0.76rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 0.45rem;">
            6. Formato de Salida Oficial:
          </label>
          <div style="display: flex; gap: 1.25rem; flex-wrap: wrap;">
            <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; color: #ffffff; cursor: pointer;">
              <input type="radio" name="format" value="download" checked> 📥 Descargar .PDF (PDFKit)
            </label>
            <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; color: #ffffff; cursor: pointer;">
              <input type="radio" name="format" value="inline"> 👁️ Abrir en Visor PDF
            </label>
            <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; color: #ffffff; cursor: pointer;">
              <input type="radio" name="format" value="html"> 🖨️ Vista Web Imprimible
            </label>
          </div>
        </div>

        <!-- Botones de Acción -->
        <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
          <button type="button" class="dash-btn-secondary" onclick="closeReportModal()">Cancelar</button>
          <button type="submit" class="dash-btn-primary">
            🚀 Generar Documento Oficial
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Inclusión de Footer Corporativo -->
  <%- include('../partials/footer') %>

  <!-- ========================================================
       SCRIPTS DE DATA VISUALIZATION Y CONTROL (DIONKEL)
       ======================================================== -->
  <script id="chart-data" type="application/json"><%- JSON.stringify(chartData) %></script>
  <script>
    // Inyección de datos provistos por el controlador de Dionkel
    const chartConfigData = JSON.parse(document.getElementById('chart-data').textContent || '{}');

    let mainChartInstance = null;
    let fleetChartInstance = null;
    let currentMode = 'hours';

    document.addEventListener('DOMContentLoaded', () => {
      initMainOperationsChart();
      initFleetCompositionChart();
    });

    // 1. Gráfico Principal de Operaciones (Línea con Gradiente y Glow)
    function initMainOperationsChart() {
      const ctx = document.getElementById('mainOperationsChart').getContext('2d');

      // Gradiente dorado / cyan de lujo
      const goldGradient = ctx.createLinearGradient(0, 0, 0, 300);
      goldGradient.addColorStop(0, 'rgba(197, 160, 89, 0.45)');
      goldGradient.addColorStop(1, 'rgba(197, 160, 89, 0.0)');

      mainChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: chartConfigData.flightMonths,
          datasets: [{
            label: 'Horas de Vuelo Mensuales',
            data: chartConfigData.flightHoursData,
            borderColor: '#c5a059',
            backgroundColor: goldGradient,
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#070d1e',
            pointBorderColor: '#c5a059',
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 7,
            pointHoverBackgroundColor: '#c5a059',
            pointHoverBorderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(7, 13, 30, 0.95)',
              titleColor: '#c5a059',
              bodyColor: '#f8fafc',
              borderColor: 'rgba(197, 160, 89, 0.4)',
              borderWidth: 1,
              padding: 12,
              displayColors: false,
              callbacks: {
                label: function(context) {
                  return currentMode === 'hours' 
                    ? ` ${context.parsed.y} Horas de Vuelo` 
                    : ` $${context.parsed.y}M USD Facturados`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#94a3b8', font: { family: 'Montserrat', size: 11 } }
            },
            y: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { 
                color: '#94a3b8', 
                font: { family: 'Montserrat', size: 11 },
                callback: function(value) {
                  return currentMode === 'hours' ? value + ' h' : '$' + value + 'M';
                }
              }
            }
          }
        }
      });
    }

    // 2. Gráfico Secundario (Doughnut de Flota)
    function initFleetCompositionChart() {
      const ctx = document.getElementById('fleetCompositionChart').getContext('2d');
      fleetChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: chartConfigData.categoriesLabels,
          datasets: [{
            data: chartConfigData.categoriesData,
            backgroundColor: [
              '#c5a059', // Oro
              '#38bdf8', // Cyan
              '#10b981', // Verde esmeralda
              '#f59e0b', // Ámbar
              '#818cf8'  // Índigo
            ],
            borderColor: '#111e42',
            borderWidth: 3,
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(7, 13, 30, 0.95)',
              titleColor: '#ffffff',
              bodyColor: '#c5a059',
              borderColor: 'rgba(197, 160, 89, 0.4)',
              borderWidth: 1,
              padding: 10
            }
          },
          cutout: '72%'
        }
      });
    }

    // Alternar dataset de gráfico principal
    function switchChartDataset(mode) {
      currentMode = mode;
      const btnHours = document.getElementById('btn-show-hours');
      const btnRevenue = document.getElementById('btn-show-revenue');

      if (mode === 'hours') {
        btnHours.classList.add('active');
        btnRevenue.classList.remove('active');
        mainChartInstance.data.datasets[0].label = 'Horas de Vuelo Mensuales';
        mainChartInstance.data.datasets[0].data = chartConfigData.flightHoursData;
        mainChartInstance.data.datasets[0].borderColor = '#c5a059';
      } else {
        btnRevenue.classList.add('active');
        btnHours.classList.remove('active');
        mainChartInstance.data.datasets[0].label = 'Facturación Charter ($M USD)';
        mainChartInstance.data.datasets[0].data = chartConfigData.charterRevenueData;
        mainChartInstance.data.datasets[0].borderColor = '#38bdf8';
      }
      mainChartInstance.update();
    }

    // Control del Modal de Exportación PDF & Filtros (Dionkel)
    function openReportModal() {
      document.getElementById('reportModal').classList.add('active');
      updateModalStatusOptions();
    }

    function openReportModalWith(reportType) {
      document.getElementById('reportSelect').value = reportType;
      openReportModal();
    }

    function closeReportModal() {
      document.getElementById('reportModal').classList.remove('active');
    }

    // Adaptar dinámicamente las opciones de estatus según el tipo de reporte
    function updateModalStatusOptions() {
      const type = document.getElementById('reportSelect').value;
      const statusSelect = document.getElementById('reportStatus');
      statusSelect.innerHTML = '';

      if (type === 'operaciones') {
        statusSelect.innerHTML = `
          <option value="all">Todos los Registros</option>
          <option value="in_flight">✈️ En Vuelo (Activos)</option>
          <option value="confirmed">✓ Confirmados</option>
          <option value="pending">⏳ Cotizaciones Pendientes</option>
          <option value="completed">• Misiones Completadas</option>
        `;
      } else if (type === 'inventario') {
        statusSelect.innerHTML = `
          <option value="all">Todos los Registros</option>
          <option value="available">🟢 Disponibles para Venta</option>
          <option value="reserved">🟡 En Proceso / Reservados</option>
          <option value="maintenance">🔴 En Mantenimiento AOG</option>
        `;
      } else if (type === 'candidatos') {
        statusSelect.innerHTML = `
          <option value="all">Todos los Postulantes</option>
          <option value="in_review">🔍 En Filtro / Revisión</option>
          <option value="interview">🎙️ En Entrevista / Simulador</option>
          <option value="accepted">✅ Aprobados / Contratables</option>
        `;
      } else {
        statusSelect.innerHTML = `
          <option value="all">Consolidado Total Q3</option>
        `;
      }
    }

    // Manejar selector rápido de periodos
    function handlePeriodQuickChange() {
      const period = document.getElementById('reportPeriodQuick').value;
      const customBox = document.getElementById('customDateRange');
      const startInput = document.getElementById('reportStartDate');
      const endInput = document.getElementById('reportEndDate');

      const today = new Date().toISOString().slice(0, 10);

      if (period === 'custom') {
        customBox.style.display = 'grid';
      } else if (period === 'last_30_days') {
        customBox.style.display = 'none';
        const d = new Date();
        d.setDate(d.getDate() - 30);
        startInput.value = d.toISOString().slice(0, 10);
        endInput.value = today;
      } else if (period === 'q3_2026') {
        customBox.style.display = 'none';
        startInput.value = '2026-07-01';
        endInput.value = '2026-09-30';
      } else {
        customBox.style.display = 'none';
        startInput.value = '';
        endInput.value = '';
      }
    }

    // Procesar y disparar exportación oficial
    function handleExportPDF(e) {
      e.preventDefault();
      const reportType = document.getElementById('reportSelect').value;
      const entity = document.getElementById('reportEntity').value.trim();
      const taxId = document.getElementById('reportTaxId').value.trim();
      const startDate = document.getElementById('reportStartDate').value;
      const endDate = document.getElementById('reportEndDate').value;
      const status = document.getElementById('reportStatus').value;
      const notes = document.getElementById('reportNotes').value.trim();
      const format = document.querySelector('input[name="format"]:checked').value;

      closeReportModal();

      const params = new URLSearchParams({
        format,
        status,
        entity,
        taxId,
        startDate,
        endDate,
        notes
      });

      const targetUrl = `/admin/reportes/pdf/${reportType}?${params.toString()}`;

      if (format === 'download') {
        // Disparar descarga directa
        window.location.href = targetUrl;
      } else {
        // Abrir visor PDF o vista HTML en nueva pestaña
        window.open(targetUrl, '_blank');
      }
    }

    // Cerrar modal al dar clic fuera
    window.addEventListener('click', (e) => {
      const modal = document.getElementById('reportModal');
      if (e.target === modal) {
        closeReportModal();
      }
    });
  </script>
</body>
</html>

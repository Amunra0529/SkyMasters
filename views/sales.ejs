              <h4 class="text-xs uppercase tracking-wider font-extrabold text-slate-300 mb-1.5">Descripción</h4>
              <p id="drawer-desc-text"
                class="text-xs text-slate-300/90 leading-relaxed bg-slate-900/60 p-3 rounded-xl border border-slate-800/80 whitespace-pre-line">
              </p>
            </div>

            <!-- Reporte de Daños: DATO CONFIDENCIAL - no disponible en vista pública -->

            <!-- Aviso Institucional de Privacidad de Log Books -->
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-3 flex items-start gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="w-4 h-4 text-amber-400 mt-0.5 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              <div class="text-[11px] text-slate-400 leading-relaxed">
                <strong class="text-slate-200 block mb-0.5">Privacidad Técnica Certificada</strong>
                Los libros de mantenimiento (Log Books) y bitácoras son confidenciales y se presentan en fase de
                pre-compra o inspección física.
              </div>
            </div>

          </div>

          <!-- Pie Fijo del Drawer -->
          <div
            class="px-5 py-4 border-t border-slate-800/80 bg-slate-900/80 backdrop-blur-md flex items-center justify-between gap-3 flex-shrink-0">
            <div>
              <span class="text-[9px] uppercase tracking-widest text-slate-400 font-medium block">Precio</span>
              <span id="drawer-price" class="text-base sm:text-lg font-extrabold text-amber-400"></span>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" onclick="closeDetailDrawer()"
                class="px-3 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 transition-colors cursor-pointer">
                Cerrar
              </button>
              <a id="drawer-whatsapp-btn" href="#" target="_blank"
                class="px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-amber-400 hover:bg-amber-300 text-slate-950 transition-all hover:scale-105 shadow-lg flex items-center gap-1.5 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                  stroke="currentColor" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                </svg>
                COMPRAR
              </a>
            </div>
          </div>

        </aside>
      </div>

    </main>

    <!-- Datos del Catálogo serializados de forma 100% segura mediante JSON block -->
    <script type="application/json" id="catalog-data-raw">
<%- JSON.stringify(typeof aircrafts !== 'undefined' ? aircrafts : []) %>
    </script>

    <script>
      window.catalogData = {};
      try {
        const rawJsonEl = document.getElementById('catalog-data-raw');
        if (rawJsonEl && rawJsonEl.textContent) {
          const rawCatalog = JSON.parse(rawJsonEl.textContent);
          rawCatalog.forEach(item => {
            if (item && item.id) {
              const key = (item.category || item.item_type) + '_' + item.id;
              window.catalogData[key] = item;
            }
          });
        }
      } catch (err) {
        console.error('Error al inicializar catalogData:', err);
      }
    </script>

    <!-- Scripts de Funcionalidad General -->
    <script>
      // 1. Alternar formularios con visibilidad exclusiva y scroll con compensación
      function toggleForm(sectionId) {
        const formSection = document.getElementById(sectionId);
        const otherId = sectionId === 'form-section' ? 'form-section-pieza' : 'form-section';
        const otherSection = document.getElementById(otherId);

        if (otherSection) {
          otherSection.classList.add('hidden');
        }

        if (formSection) {
          if (formSection.classList.contains('hidden')) {
            formSection.classList.remove('hidden');

            setTimeout(() => {
              const headerOffset = 95;
              const elementPosition = formSection.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
              window.scrollTo({
                top: Math.max(0, offsetPosition),
                behavior: 'smooth'
              });
            }, 60);
          } else {
            formSection.classList.add('hidden');
          }
        }
      }

      // 2. Al enviar cualquier formulario, hacer scroll suave al inicio
      document.getElementById('form-vender-aeronave')?.addEventListener('submit', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('form-vender-pieza')?.addEventListener('submit', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // 3. Comprobar parámetro ?success=1 al cargar y volver arriba
      window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('success') === '1') {
          const successToast = document.getElementById('success-toast');
          if (successToast) {
            successToast.classList.remove('hidden');
          }
          document.getElementById('form-section')?.classList.add('hidden');
          document.getElementById('form-section-pieza')?.classList.add('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      });

      // 4. Filtros de categoría y búsqueda
      let currentCategory = 'all';

      function setCategory(category) {
        currentCategory = category;

        document.querySelectorAll('.tab-btn').forEach(btn => {
          btn.classList.remove('bg-amber-500', 'text-slate-950', 'font-semibold', 'shadow-md');
          btn.classList.add('text-slate-400', 'font-medium');
        });

        const activeBtn = document.getElementById(`tab-${category}`);
        if (activeBtn) {
          activeBtn.classList.add('bg-amber-500', 'text-slate-950', 'font-semibold', 'shadow-md');
          activeBtn.classList.remove('text-slate-400', 'font-medium');
        }

        applyFilters();
      }

      function applyFilters() {
        const query = document.getElementById('search-input').value.toLowerCase().trim();
        const minPrice = parseFloat(document.getElementById('min-price').value) || 0;
        const maxPrice = parseFloat(document.getElementById('max-price').value) || Infinity;
        const cards = document.querySelectorAll('.card-item');
        let visibleCount = 0;

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const price = parseFloat(card.getAttribute('data-price') || '0');
          const cardText = card.innerText.toLowerCase();

          const matchesCategory = (currentCategory === 'all' || category === currentCategory);
          const matchesText = cardText.includes(query);
          const matchesPrice = (price >= minPrice && price <= maxPrice);

          if (matchesCategory && matchesText && matchesPrice) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        const emptyState = document.getElementById('empty-state');
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      function resetFilters() {
        document.getElementById('search-input').value = '';
        document.getElementById('min-price').value = '0';
        document.getElementById('max-price').value = 'Infinity';
        setCategory('all');
      }

      // 5. Desplegar/ocultar campos adjuntos según el selector SÍ/NO
      function toggleFileField(containerId, value) {
        const container = document.getElementById(containerId);
        if (container) {
          if (value === "1") {
            container.classList.remove('hidden');
          } else {
            container.classList.add('hidden');
          }
        }
      }

      // 6. Actualizar contador simple de archivos para aeronave
      function updateFileCount(input, targetId) {
        const countSpan = document.getElementById(targetId);
        if (input.files && input.files.length > 0) {
          countSpan.textContent = input.files.length === 1
            ? '1 archivo'
            : `${input.files.length} archivos`;
          countSpan.classList.remove('text-slate-400');
          countSpan.classList.add('text-amber-400', 'font-semibold');
        } else {
          countSpan.textContent = 'Ningún archivo seleccionado';
          countSpan.classList.remove('text-amber-400', 'font-semibold');
          countSpan.classList.add('text-slate-400');
        }
      }

      // 7. Contador visual en tiempo real de imágenes en formulario de piezas
      function handlePiezaFiles(input) {
        const countSpan = document.getElementById('pieza-fotos-count');
        const badgeSpan = document.getElementById('pieza-fotos-badge');
        const previewContainer = document.getElementById('pieza-fotos-preview');
        previewContainer.innerHTML = '';

        if (input.files && input.files.length > 0) {
          const files = Array.from(input.files);
          const count = files.length;

          countSpan.textContent = count === 1 ? '1 imagen seleccionada' : `${count} imágenes seleccionadas`;
          countSpan.classList.remove('text-slate-400');
          countSpan.classList.add('text-amber-400', 'font-bold');

          badgeSpan.textContent = `${count} / 4`;
          badgeSpan.classList.remove('hidden');

          previewContainer.classList.remove('hidden');

          files.forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function (e) {
              const itemDiv = document.createElement('div');
              itemDiv.className = 'relative group w-14 h-14 rounded-lg overflow-hidden border border-amber-500/50 shadow-md bg-slate-900 flex-shrink-0';
              itemDiv.innerHTML = `
                <img src="${e.target.result}" alt="Preview ${index + 1}" class="w-full h-full object-cover">
                <span class="absolute top-0.5 right-0.5 bg-slate-950/80 text-amber-400 text-[9px] font-bold px-1 rounded backdrop-blur-sm">#${index + 1}</span>
              `;
              previewContainer.appendChild(itemDiv);
            };
            reader.readAsDataURL(file);
          });
        } else {
          countSpan.textContent = 'Ningún archivo seleccionado';
          countSpan.classList.remove('text-amber-400', 'font-bold');
          countSpan.classList.add('text-slate-400');
          badgeSpan.classList.add('hidden');
          previewContainer.classList.add('hidden');
        }
      }

      // 8. Control del Panel Lateral Deslizante (Drawer)
      function openDetailDrawer(key) {
        const item = window.catalogData ? window.catalogData[key] : null;
        if (!item) return;

        const container = document.getElementById('detail-drawer-container');
        const backdrop = document.getElementById('detail-drawer-backdrop');
        const drawer = document.getElementById('detail-drawer');

        const isPart = item.category === 'part';
        const cleanPN = (item.part_number || item.codigo_publico || '').toString().replace(/^(pieza\s*p\/n\s*:?|repuesto\s*p\/n\s*:?|p\/n\s*:?|part\s*number\s*:?)\s*/i, '').trim();

        // Encabezado del Drawer
        document.getElementById('drawer-category-badge').textContent = isPart ? 'Repuestos & Turbinas' : 'Flota de Aeronaves';
        document.getElementById('drawer-title').textContent = isPart ? ('Part Number: ' + cleanPN) : (item.model || item.codigo_publico);
        document.getElementById('drawer-price').textContent = `$${Number(item.price).toLocaleString('en-US')} USD`;

        // Botón WhatsApp
        const phone = (item.vendedor_telefono || '584120000000').replace(/[^0-9]/g, '');
        const waTitle = isPart ? ('Part Number: ' + cleanPN) : (item.model || item.codigo_publico);
        const waText = encodeURIComponent(`Hola, me interesa comprar: ${waTitle} (Ref ID: ${item.id})`);
        document.getElementById('drawer-whatsapp-btn').href = `https://wa.me/${phone}?text=${waText}`;

        // Galería Interactiva
        const gallerySection = document.getElementById('drawer-gallery-section');
        const mainImg = document.getElementById('drawer-main-img');
        const imgTag = document.getElementById('drawer-img-tag');
        const thumbsContainer = document.getElementById('drawer-thumbnails');
        const tabsContainer = document.getElementById('drawer-gallery-tabs');

        thumbsContainer.innerHTML = '';
        tabsContainer.innerHTML = '';

        const images = (item.imagenes && item.imagenes.length > 0)
          ? item.imagenes.filter(src => src && !src.includes('card_parts.jpg') && !src.includes('card_sales.jpg'))
          : (item.image_url && !item.image_url.includes('card_parts.jpg') && !item.image_url.includes('card_sales.jpg') ? [item.image_url] : []);

        if (isPart && images.length === 0) {
          // Ocultar sección de fotos si la pieza no tiene imágenes
          gallerySection.classList.add('hidden');
        } else {
          gallerySection.classList.remove('hidden');
          const displayImgs = images.length > 0 ? images : [item.image_url || '/img/card_sales.jpg'];
          const interiorImgs = item.fotos_interior || [];
          const exteriorImgs = item.fotos_exterior || [];

          mainImg.src = displayImgs[0];
          imgTag.textContent = isPart ? 'Pieza Certificada' : (exteriorImgs.includes(displayImgs[0]) ? 'Exterior' : (interiorImgs.includes(displayImgs[0]) ? 'Interior' : 'Vista General'));

          function renderThumbs(imgList, tagLabel) {
            thumbsContainer.innerHTML = '';
            if (!imgList || imgList.length === 0) return;
            imgList.forEach((src, idx) => {
              const thumb = document.createElement('button');
              thumb.type = 'button';
              thumb.className = `flex-shrink-0 w-14 h-10 rounded-lg overflow-hidden border-2 transition-all cursor-pointer ${idx === 0 ? 'border-amber-400 scale-105' : 'border-slate-800 opacity-70 hover:opacity-100'}`;
              thumb.innerHTML = `<img src="${src}" class="w-full h-full object-cover" onerror="this.src='/img/card_sales.jpg'">`;
              thumb.onclick = () => {
                mainImg.src = src;
                imgTag.textContent = tagLabel || 'Foto';
                thumbsContainer.querySelectorAll('button').forEach(b => {
                  b.className = 'flex-shrink-0 w-14 h-10 rounded-lg overflow-hidden border-2 border-slate-800 opacity-70 hover:opacity-100 transition-all cursor-pointer';
                });
                thumb.className = 'flex-shrink-0 w-14 h-10 rounded-lg overflow-hidden border-2 border-amber-400 scale-105 transition-all cursor-pointer';
              };
              thumbsContainer.appendChild(thumb);
            });
          }

          if (!isPart && (interiorImgs.length > 0 || exteriorImgs.length > 0)) {
            tabsContainer.innerHTML = `
              <button type="button" id="drawer-tab-all" class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-500 text-slate-950 transition-colors cursor-pointer">Todas (${displayImgs.length})</button>
              ${exteriorImgs.length > 0 ? `<button type="button" id="drawer-tab-ext" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-amber-400 transition-colors cursor-pointer">Exterior (${exteriorImgs.length})</button>` : ''}
              ${interiorImgs.length > 0 ? `<button type="button" id="drawer-tab-int" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-amber-400 transition-colors cursor-pointer">Interior (${interiorImgs.length})</button>` : ''}
            `;

            const switchTab = (tabId, list, label) => {
              tabsContainer.querySelectorAll('button').forEach(b => {
                b.className = 'px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-amber-400 transition-colors cursor-pointer';
              });
              document.getElementById(tabId).className = 'px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-500 text-slate-950 transition-colors cursor-pointer';
              if (list.length > 0) {
                mainImg.src = list[0];
                imgTag.textContent = label;
              }
              renderThumbs(list, label);
            };

            document.getElementById('drawer-tab-all').onclick = () => switchTab('drawer-tab-all', displayImgs, 'General');
            if (document.getElementById('drawer-tab-ext')) {
              document.getElementById('drawer-tab-ext').onclick = () => switchTab('drawer-tab-ext', exteriorImgs, 'Exterior');
            }
            if (document.getElementById('drawer-tab-int')) {
              document.getElementById('drawer-tab-int').onclick = () => switchTab('drawer-tab-int', interiorImgs, 'Interior');
            }

            renderThumbs(displayImgs, 'General');
          } else {
            renderThumbs(displayImgs, isPart ? 'Pieza' : 'General');
          }
        }

        // Especificaciones
        const specsGrid = document.getElementById('drawer-specs-grid');
        specsGrid.innerHTML = '';

        const addSpec = (label, val, icon = '', isHighlight = false) => {
          const el = document.createElement('div');
          if (isHighlight) {
            el.className = 'col-span-2 bg-gradient-to-r from-amber-500/20 via-slate-900 to-slate-900/90 border-2 border-amber-400/80 rounded-xl p-3 flex flex-col justify-center shadow-lg';
            el.innerHTML = `
              <span class="text-[10px] uppercase tracking-wider text-amber-300 font-extrabold flex items-center gap-1.5">${icon} ${label}</span>
              <span class="text-sm font-black text-amber-300 mt-1 truncate">${val || 'N/A'}</span>
            `;
          } else {
            el.className = 'bg-slate-900/90 border border-slate-700/80 rounded-xl p-2.5 flex flex-col justify-center shadow-sm';
            el.innerHTML = `
              <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold flex items-center gap-1">${icon} ${label}</span>
              <span class="text-xs font-bold text-white mt-0.5 truncate">${val || 'N/A'}</span>
            `;
          }
          specsGrid.appendChild(el);
        };

        if (isPart) {
          addSpec('Part Number', cleanPN, '🏭');
          addSpec('Disponibilidad', item.estado || 'Disponible', '⚡');
          addSpec('Trazabilidad', 'Garantizada', '🛡️');
          addSpec('Estado', item.estado || 'En Venta', '📦');
        } else {
          addSpec('Horas Totales', item.hours ? `${item.hours} hrs` : (item.horas_totales ? `${item.horas_totales} hrs` : 'N/A'), '⏱️', true);
          addSpec('Año', item.year, '📅');
          addSpec('Horas Motores', item.horas_motores ? `${item.horas_motores} hrs` : 'N/A', '⚙️');
          addSpec('Horas Turbinas / APU', item.horas_turbinas ? `${item.horas_turbinas} hrs` : 'N/A', '🌀');
          addSpec('Ubicación', item.ubicacion || 'Internacional', '📍');
          addSpec('Estado', item.estado || 'En Venta', '⚡');
        }

        // Descripción
        const descContainer = document.getElementById('drawer-desc-container');
        const descText = document.getElementById('drawer-desc-text');
        if (item.descripcion && item.descripcion.trim()) {
          descText.textContent = item.descripcion;
          descContainer.classList.remove('hidden');
        } else {
          descContainer.classList.add('hidden');
        }

        // Reporte de Daños: dato privado/confidencial — removido completamente del catálogo público.

        // Abrir Drawer deslizante lateral
        container.classList.remove('pointer-events-none');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
        document.body.classList.add('overflow-hidden');
      }

      function closeDetailDrawer() {
        const container = document.getElementById('detail-drawer-container');
        const backdrop = document.getElementById('detail-drawer-backdrop');
        const drawer = document.getElementById('detail-drawer');

        if (!drawer) return;

        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');

        setTimeout(() => {
          container.classList.add('pointer-events-none');
          document.body.classList.remove('overflow-hidden');
        }, 300);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDetailDrawer();
      });
    </script>

    <!-- Inclusión de Footer -->
    <%- include('partials/footer') %>

</body>

</html>
        <!-- Estado Vacío: Cuando no se encuentren resultados a la busqueda -->
        <div id="empty-state"
          class="hidden text-center py-16 bg-slate-900/40 border border-slate-800/80 rounded-2xl backdrop-blur-md mt-6">
          <div class="w-10 h-10 mx-auto text-amber-400/80 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>

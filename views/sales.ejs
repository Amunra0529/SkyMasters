                Cotizar
              </a>
            </div>
          </div>

          <!-- Tarjeta 3: Cessna Citation Latitude -->
          <div data-category="aircraft" data-price="16500000"
            class="card-item group bg-slate-900/70 border border-slate-800 rounded-xl overflow-hidden hover:border-amber-500/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between shadow-xl backdrop-blur-md">
            <div>
              <div class="relative overflow-hidden">
                <img src="/img/card_sales.jpg" alt="Cessna Citation Latitude"
                  class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500">
                <span
                  class="absolute top-3 right-3 bg-amber-500 text-slate-950 font-bold text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                  Disponible
                </span>
              </div>
              <div class="p-5">
                <span class="text-[11px] text-amber-400 font-semibold tracking-wider uppercase">Jet Mediano •
                  Textron</span>
                <h3 class="text-lg font-bold text-white mt-0.5 group-hover:text-amber-300 transition-colors">Cessna
                  Citation Latitude</h3>
                <p class="text-slate-400 text-xs mt-0.5">Año 2020</p>

                <div
                  class="grid grid-cols-2 gap-2 my-4 py-3 border-y border-slate-800/80 text-xs text-slate-300/90 font-normal">
                  <div class="flex items-center gap-1.5">🏭 <span><strong>Fab:</strong> Textron</span></div>
                  <div class="flex items-center gap-1.5">📅 <span><strong>Año:</strong> 2020</span></div>
                  <div class="flex items-center gap-1.5">⏱ <span><strong>Horas:</strong> 1,200 hrs</span></div>
                  <div class="flex items-center gap-1.5">📜 <span><strong>Cert:</strong> FAA/EASA</span></div>
                </div>
              </div>
            </div>

            <div class="px-5 pb-5 pt-1 flex items-center justify-between border-t border-slate-800/40">
              <div>
                <span class="text-[9px] text-slate-400 uppercase tracking-widest block font-medium">Precio de
                  Lista</span>
                <span class="text-sm font-bold text-slate-100">$16,500,000 USD</span>
              </div>
              <a href="https://wa.me/584120000000?text=Hola,%20me%20interesa%20el%20Cessna%20Citation%20Latitude"
                target="_blank"
                class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3.5 py-1.5 rounded-lg text-xs uppercase tracking-wide transition-all duration-200 shadow-md">
                Cotizar
              </a>
            </div>
          </div>

          <!-- Tarjeta 4: Beechcraft King Air 350i (Nueva) -->
          <div data-category="aircraft" data-price="4800000"
            class="card-item group bg-slate-900/70 border border-slate-800 rounded-xl overflow-hidden hover:border-amber-500/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between shadow-xl backdrop-blur-md">
            <div>
              <div class="relative overflow-hidden">
                <img src="/img/card_brokerage.jpg" alt="Beechcraft King Air 350i"
                  class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500">
                <span
                  class="absolute top-3 right-3 bg-amber-500 text-slate-950 font-bold text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                  Disponible
                </span>
              </div>
              <div class="p-5">
                <span class="text-[11px] text-amber-400 font-semibold tracking-wider uppercase">Turbohélice •
                  Beechcraft</span>
                <h3 class="text-lg font-bold text-white mt-0.5 group-hover:text-amber-300 transition-colors">King Air
                  350i</h3>
                <p class="text-slate-400 text-xs mt-0.5">Año 2017</p>

                <div
                  class="grid grid-cols-2 gap-2 my-4 py-3 border-y border-slate-800/80 text-xs text-slate-300/90 font-normal">
                  <div class="flex items-center gap-1.5">🏭 <span><strong>Fab:</strong> Beechcraft</span></div>
                  <div class="flex items-center gap-1.5">📅 <span><strong>Año:</strong> 2017</span></div>
                  <div class="flex items-center gap-1.5">⏱️ <span><strong>Horas:</strong> 2,100 hrs</span></div>
                  <div class="flex items-center gap-1.5">📜 <span><strong>Cert:</strong> FAA</span></div>
                </div>
              </div>
            </div>

            <div class="px-5 pb-5 pt-1 flex items-center justify-between border-t border-slate-800/40">
              <div>
                <span class="text-[9px] text-slate-400 uppercase tracking-widest block font-medium">Precio de
                  Lista</span>
                <span class="text-sm font-bold text-slate-100">$4,800,000 USD</span>
              </div>
              <a href="https://wa.me/584120000000?text=Hola,%20me%20interesa%20el%20King%20Air%20350i" target="_blank"
                class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3.5 py-1.5 rounded-lg text-xs uppercase tracking-wide transition-all duration-200 shadow-md">
                Cotizar
              </a>
            </div>
          </div>

          <!-- Tarjeta 5: Turbina Pratt & Whitney PT6A -->
          <div data-category="part" data-price="420000"
            class="card-item group bg-slate-900/70 border border-slate-800 rounded-xl overflow-hidden hover:border-amber-500/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between shadow-xl backdrop-blur-md">
            <div>
              <div class="relative overflow-hidden">
                <img src="/img/card_parts.jpg" alt="Turbina Pratt & Whitney PT6A"
                  class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500">
                <span
                  class="absolute top-3 right-3 bg-slate-950/90 text-amber-400 border border-amber-500/30 font-bold text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-md backdrop-blur-md">
                  Pieza / Motor
                </span>
              </div>
              <div class="p-5">
                <span class="text-[11px] text-amber-400 font-semibold tracking-wider uppercase">Piezas • P&W</span>
                <h3 class="text-lg font-bold text-white mt-0.5 group-hover:text-amber-300 transition-colors">Turbina
                  PT6A-60A</h3>
                <p class="text-slate-400 text-xs mt-0.5">Año 2022 • Condición: Overhaul</p>

                <div
                  class="grid grid-cols-2 gap-2 my-4 py-3 border-y border-slate-800/80 text-xs text-slate-300/90 font-normal">
                  <div class="flex items-center gap-1.5">🏭 <span><strong>Fab:</strong> P&W</span></div>
                  <div class="flex items-center gap-1.5">📅 <span><strong>Año:</strong> 2022</span></div>
                  <div class="flex items-center gap-1.5">⚙️ <span><strong>Uso:</strong> Turboprop</span></div>
                  <div class="flex items-center gap-1.5">📜 <span><strong>Cert:</strong> Form 8130</span></div>
                </div>
              </div>

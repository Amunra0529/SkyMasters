<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Venta de Aeronaves y Piezas | SkyMaster' %>
  </title>
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Tailwind CSS por CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    /* Quitar flechas y spinners nativos en inputs tipo number */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    input[type="number"] {
      -moz-appearance: textfield;
      appearance: textfield;
    }

    /* Scrollbar estilizada para miniaturas y drawer */
    .scrollbar-thin::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }

    .scrollbar-thin::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
      border-radius: 9999px;
    }

    .scrollbar-thin::-webkit-scrollbar-thumb {
      background: rgba(245, 158, 11, 0.5);
      border-radius: 9999px;
    }

    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
      background: rgba(245, 158, 11, 0.8);
    }
  </style>
</head>

<body class="bg-slate-950 text-slate-100 flex flex-col min-h-screen">

  <!-- Inclusión de Barra de Navegación Pública -->
  <%- include('partials/navbar') %>

    <main class="main-content flex-grow font-['Montserrat'] text-slate-100 bg-slate-950 w-full overflow-x-hidden">

      <!-- Banner Hero Principal -->
      <section
        class="relative w-screen left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] -mt-10 pt-24 pb-20 md:pt-32 md:pb-28 px-6 text-center border-b border-slate-800/80 bg-cover bg-center bg-no-repeat shadow-2xl"
        style="background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.55), rgba(15, 23, 42, 0.85)), url('/img/contact_tarmac.jpg');">
        <div class="max-w-5xl mx-auto">
          <span
            class="text-amber-400/90 font-semibold uppercase tracking-widest text-xs px-4 py-1.5 bg-amber-500/10 rounded-full border border-amber-500/30 backdrop-blur-md inline-block">
            Exclusividad & Desempeño Executive
          </span>
          <h1 class="text-3xl md:text-5xl font-extrabold mt-5 tracking-tight text-white drop-shadow-md">
            Catálogo de Aeronaves & Repuestos
          </h1>

          <!-- Botones de Acción -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
            <!-- Botón que despliega el formulario de aeronave -->
            <button type="button" onclick="toggleForm('form-section')"
              class="w-full sm:w-auto px-6 py-3.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider rounded-xl shadow-lg hover:shadow-amber-500/20 hover:-translate-y-0.5 transition-all duration-300 backdrop-blur-sm border border-amber-400/50 flex items-center justify-center gap-2 cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
              Vender mi Aeronave
            </button>

            <!-- Botón que despliega el formulario de piezas -->
            <button type="button" onclick="toggleForm('form-section-pieza')"
              class="w-full sm:w-auto px-6 py-3.5 bg-slate-900/90 hover:bg-slate-800 text-amber-400 hover:text-amber-300 font-extrabold text-xs uppercase tracking-wider rounded-xl shadow-lg border border-amber-500/40 hover:border-amber-400/70 hover:-translate-y-0.5 transition-all duration-300 backdrop-blur-md flex items-center justify-center gap-2 cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766l1.232-.369a2.25 2.25 0 0 0 1.503-2.122v-.387a2.25 2.25 0 0 0-.659-1.591l-.643-.643a2.25 2.25 0 0 0-1.591-.659h-.387a2.25 2.25 0 0 0-2.122 1.503l-.369 1.232c-.14.468-.382.891-.766 1.208l-3.03 2.496m0 0a2.25 2.25 0 0 1-3.182 0l-1.061-1.06a2.25 2.25 0 0 1 0-3.182l3.03-2.496c.384-.317.626-.74.766-1.208l.369-1.232A2.25 2.25 0 0 1 9.083 2h.387a2.25 2.25 0 0 1 1.591.659l.643.643c.422.422.659.995.659 1.591v.387a2.25 2.25 0 0 1-1.503 2.122l-1.232.369a2.25 2.25 0 0 0-1.208.766l-2.496 3.03" />
              </svg>
              Vender una Pieza / Repuesto
            </button>
          </div>

          <p class="text-slate-200/90 mt-4 text-sm md:text-lg max-w-2xl mx-auto font-light leading-relaxed">
            Adquisición ejecutiva de jets, helicópteros y partes certificadas FAA/EASA con trazabilidad garantizada.
          </p>
        </div>
      </section>

      <!-- Mensaje Notificación de Éxito al Enviar Solicitud -->
      <div id="success-toast" class="hidden max-w-5xl mx-auto px-4 sm:px-6 mt-6">
        <div
          class="bg-amber-500/10 border border-amber-500/40 rounded-2xl p-4 sm:p-5 flex items-center justify-between backdrop-blur-md shadow-2xl text-amber-300">
          <div class="flex items-center gap-3.5">
            <div
              class="w-9 h-9 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400 flex-shrink-0 border border-amber-500/30">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
            </div>
            <div>
              <p class="text-xs sm:text-sm font-extrabold text-white">¡Solicitud recibida correctamente!</p>
              <p class="text-[11px] sm:text-xs text-slate-300">Su publicación ha sido registrada y será validada por
                nuestro equipo comercial para su inclusión en catálogo.</p>
            </div>
          </div>
          <button type="button" onclick="document.getElementById('success-toast').classList.add('hidden')"
            class="text-slate-400 hover:text-white p-1.5 transition-colors cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
              stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Contenido Principal: Catálogo -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

        <!-- Bloque de Controles Principal: Pestañas + Buscador -->
        <div
          class="flex flex-col lg:flex-row justify-between items-stretch lg:items-center mb-6 gap-4 border-b border-slate-800/80 pb-6">

          <!-- Pestañas (Tabs Interactivas) -->
          <div class="inline-flex rounded-xl bg-slate-900/90 p-1.5 border border-slate-800 shadow-inner overflow-x-auto"
            id="tab-container">
            <button id="tab-all" onclick="setCategory('all')"
              class="tab-btn active-tab px-4 py-2 rounded-lg text-xs md:text-sm font-semibold bg-amber-500 text-slate-950 shadow-md transition duration-200 whitespace-nowrap">
              Catálogo Completo
            </button>
            <button id="tab-aircraft" onclick="setCategory('aircraft')"
              class="tab-btn px-4 py-2 rounded-lg text-xs md:text-sm font-medium text-slate-400 hover:text-amber-300 transition duration-200 whitespace-nowrap">
              Flota de Aeronaves
            </button>
            <button id="tab-parts" onclick="setCategory('part')"
              class="tab-btn px-4 py-2 rounded-lg text-xs md:text-sm font-medium text-slate-400 hover:text-amber-300 transition duration-200 whitespace-nowrap">
              Repuestos & Turbinas
            </button>
          </div>

          <!-- Buscador -->
          <div class="relative w-full lg:w-80">
            <input type="text" id="search-input" onkeyup="applyFilters()"
              placeholder="Buscar por modelo, P/N o fabricante..."
              class="w-full bg-slate-900/90 text-slate-100 border border-slate-800 rounded-xl px-4 py-2 pl-9 pr-4 text-xs focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40 transition-all duration-300 placeholder-slate-500 shadow-sm backdrop-blur-sm">

            <span class="absolute left-3 top-2.5 text-slate-400 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-3.5 h-3.5 text-amber-500">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
            </span>
          </div>
        </div>

        <!-- Barra de Filtro Dinámico de Precio -->
        <div
          class="flex flex-wrap items-center justify-between gap-4 mb-8 bg-slate-900/50 border border-slate-800/80 px-4 py-3 rounded-xl backdrop-blur-md">
          <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">

            <span class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="w-4 h-4 text-amber-400">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.874c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
              </svg>
              Presupuesto USD:
            </span>

            <!-- Selectores de Rango Mínimo / Máximo -->
            <div class="flex items-center gap-2">
              <select id="min-price" onchange="applyFilters()"
                class="bg-slate-950 border border-slate-800 text-slate-300 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-amber-500/60 transition-colors cursor-pointer">
                <option value="0">Mín: Sin Mínimo</option>
                <option value="500000">$500,000</option>
                <option value="1000000">$1,000,000</option>
                <option value="10000000">$10,000,000</option>
                <option value="25000000">$25,000,000</option>
              </select>

              <span class="text-slate-600 text-xs">—</span>

              <select id="max-price" onchange="applyFilters()"
                class="bg-slate-950 border border-slate-800 text-slate-300 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-amber-500/60 transition-colors cursor-pointer">
                <option value="Infinity">Máx: Sin Límite</option>
                <option value="1000000">$1,000,000</option>
                <option value="15000000">$15,000,000</option>
                <option value="30000000">$30,000,000</option>
                <option value="70000000">$70,000,000</option>
              </select>
            </div>
          </div>

          <!-- Botón Restablecer -->
          <button onclick="resetFilters()"
            class="text-xs text-amber-400/80 hover:text-amber-300 underline underline-offset-4 transition-colors cursor-pointer">
            Limpiar Filtros
          </button>
        </div>

        <!-- Cuadrícula de Tarjetas VIP -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="catalog-grid">

          <% if (typeof aircrafts !=='undefined' && aircrafts.length> 0) { %>
            <% aircrafts.forEach(item=> { %>
              <% const isPart=item.category==='part' ; const cleanPN=(item.part_number || item.codigo_publico || ''
                ).toString().replace(/^(pieza\s*p\/n\s*:?|repuesto\s*p\/n\s*:?|p\/n\s*:?|part\s*number\s*:?)\s*/i, ''
                ).trim(); const hasValidImages=Boolean((item.has_images && item.image_url) || (item.imagenes &&
                item.imagenes.length> 0 && !item.imagenes[0].includes('card_parts.jpg') &&
                !item.imagenes[0].includes('card_sales.jpg')));
                %>
                <div data-category="<%= isPart ? 'part' : 'aircraft' %>" data-price="<%= item.price %>"
                  class="card-item group bg-slate-800/90 border border-slate-700/80 rounded-2xl overflow-hidden hover:border-amber-400 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between shadow-xl backdrop-blur-md">

                  <div>
                    <% if (!isPart || hasValidImages) { %>
                      <!-- Imagen de Cabecera (Condicional en piezas: solo si tiene fotos reales) -->
                      <div class="relative overflow-hidden">
                        <img src="<%= isPart ? item.image_url : (item.image_url || '/img/card_sales.jpg') %>"
                          alt="<%= isPart ? cleanPN : item.model %>"
                          onerror="if (this.closest('.card-item')?.getAttribute('data-category') === 'part') { this.closest('.relative.overflow-hidden')?.remove(); } else { this.onerror = null; this.src = '/img/card_sales.jpg'; }"
                          class="w-full h-24 sm:h-28 object-cover group-hover:scale-105 transition-transform duration-500">
                        <span
                          class="absolute top-2 right-2 bg-amber-500 text-slate-950 font-bold text-[10px] px-2 py-0.5 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                          <%= item.estado || 'Disponible' %>
                        </span>
                      </div>
                      <% } %>

                        <!-- Contenido Central de la Tarjeta -->
                        <div class="p-3">
                          <% if (isPart) { %>
                            <!-- TARJETA DE PIEZA: estrictamente Part Number, descripción y precio -->
                            <div class="flex items-center justify-between gap-2 mb-1.5">
                              <span class="text-[10px] text-amber-400 font-extrabold tracking-wider uppercase">
                                Repuestos & Turbinas
                              </span>
                              <% if (!hasValidImages) { %>
                                <span
                                  class="bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">
                                  <%= item.estado || 'Disponible' %>
                                </span>
                                <% } %>
                            </div>

                            <h3
                              class="text-sm sm:text-base font-bold text-white group-hover:text-amber-300 transition-colors">
                              Part Number: <span class="font-mono text-amber-300 font-extrabold">
                                <%= cleanPN %>
                              </span>
                            </h3>

                            <p class="text-slate-200 text-xs mt-1.5 leading-relaxed line-clamp-2">
                              <%= item.descripcion || 'Sin descripción técnica registrada.' %>
                            </p>

                            <% } else { %>
                              <!-- TARJETA DE AERONAVE -->
                              <span class="text-[10px] text-amber-400 font-extrabold tracking-wider uppercase">
                                Flota de Aeronaves
                              </span>
                              <h3
                                class="text-sm sm:text-base font-extrabold text-white mt-0.5 group-hover:text-amber-300 transition-colors truncate">
                                <%= item.model %>
                              </h3>
                              <p class="text-slate-300 text-[11px] mt-0.5 font-medium">Año <%= item.year || 'N/A' %>
                              </p>

                              <!-- Especificaciones Clave de la Aeronave: Compacto y 100% legible -->
                              <div
                                class="my-2 p-2 bg-slate-900/90 rounded-xl border border-slate-700/80 space-y-1.5 text-[11px]">
                                <!-- Fila 1: Año y Horas Totales -->
                                <div class="grid grid-cols-2 gap-1.5">
                                  <div
                                    class="flex items-center justify-between bg-slate-800/80 px-2 py-1 rounded-lg border border-slate-700/60">
                                    <span class="text-slate-300 font-medium text-[10px] flex items-center gap-1">📅
                                      Año:</span>
                                    <strong class="text-white font-bold text-[11px]">
                                      <%= item.year || 'N/A' %>
                                    </strong>
                                  </div>
                                  <div
                                    class="flex items-center justify-between bg-amber-500/15 px-2 py-1 rounded-lg border border-amber-500/30">
                                    <span class="text-amber-300 font-bold text-[10px] flex items-center gap-1">⏱️ Horas
                                      Totales:</span>
                                    <strong class="text-amber-300 font-extrabold text-[11px]">
                                      <%= item.hours ? item.hours + ' hrs' : (item.horas_totales ? item.horas_totales
                                        + ' hrs' : 'N/A' ) %>
                                    </strong>
                                  </div>
                                </div>
                                <!-- Fila 2: Horas Motores -->
                                <div
                                  class="flex items-center justify-between bg-slate-800/80 px-2 py-1 rounded-lg border border-slate-700/60">
                                  <span class="text-slate-300 font-medium text-[10px] flex items-center gap-1.5">⚙️
                                    Horas Motores:</span>
                                  <strong class="text-white font-bold text-[11px]">
                                    <%= item.horas_motores ? item.horas_motores + ' hrs' : 'N/A' %>
                                  </strong>
                                </div>
                                <!-- Fila 3: Horas Turbinas / APU -->
                                <div
                                  class="flex items-center justify-between bg-slate-800/80 px-2 py-1 rounded-lg border border-slate-700/60">
                                  <span class="text-slate-300 font-medium text-[10px] flex items-center gap-1.5">🌀
                                    Horas Turbinas / APU:</span>
                                  <strong class="text-white font-bold text-[11px]">
                                    <%= item.horas_turbinas ? item.horas_turbinas + ' hrs' : 'N/A' %>
                                  </strong>
                                </div>
                                <!-- Fila 4: Ubicación -->
                                <div
                                  class="flex items-center justify-between bg-slate-800/80 px-2 py-1 rounded-lg border border-slate-700/60">
                                  <span class="text-slate-300 font-medium text-[10px] flex items-center gap-1.5">📍
                                    Ubicación:</span>
                                  <strong class="text-slate-100 font-bold text-[11px] truncate max-w-[170px]"
                                    title="<%= item.ubicacion || 'Internacional' %>">
                                    <%= item.ubicacion || 'Internacional' %>
                                  </strong>
                                </div>
                              </div>
                              <% } %>
                        </div>
                  </div>

                  <!-- Barra Inferior de Acción -->
                  <div
                    class="px-3 py-2 flex items-center justify-between border-t border-slate-700/60 gap-2 mt-auto bg-slate-900/40">
                    <div class="flex flex-col justify-center">
                      <span
                        class="text-[9px] text-slate-300 uppercase tracking-widest block font-bold leading-none mb-0.5">Precio</span>
                      <span class="text-sm sm:text-base font-extrabold text-white leading-tight">$<%=
                          Number(item.price).toLocaleString('en-US') %>
                          USD</span>
                    </div>

                    <div class="flex items-center gap-1.5">
                      <!-- Botón Ver Detalles (Abre Panel Lateral Drawer) -->
                      <button type="button"
                        onclick="openDetailDrawer(`<%= isPart ? 'part' : 'aircraft' %>_<%= item.id %>`)"
                        class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-amber-400 border border-amber-500/30 transition-all duration-200 flex items-center gap-1.5 shadow-sm hover:border-amber-400/60 cursor-pointer active:scale-95">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                          stroke="currentColor" class="w-3.5 h-3.5">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                        <span>Ver detalles</span>
                      </button>

                      <!-- Botón COMPRAR: enlace dinámico de WhatsApp al número de la empresa -->
                      <% const empresaWA='584248101179' ; let waMsg='' ; if (isPart) { waMsg='Hola. Saludos.\n'
                        + 'Estoy interesado en solicitar informacion o comprar el siguiente repuesto:\n\n'
                        + 'Part Number: ' + cleanPN + '\n' + 'Descripcion: ' + (item.descripcion
                        || 'Sin descripcion registrada.' ) + '\n' + 'Precio publicado: $' +
                        Number(item.price).toLocaleString('en-US') + ' USD\n\n'
                        + 'Me gustaria conocer disponibilidad y proceso de compra. ¡Muchas gracias!' ; } else {
                        waMsg='Hola. Saludos.\n'
                        + 'Estoy interesado en solicitar informacion o comprar la siguiente aeronave:\n\n'
                        + 'Registro o Codigo: ' + (item.codigo_publico || item.model || 'N/A' ) + '\n'
                        + 'Ano de fabricacion: ' + (item.year || 'N/A' ) + '\n' + 'Horas totales: ' + (item.hours ||
                        item.horas_totales || 'N/A' ) + '\n' + 'Ubicacion: ' + (item.ubicacion || 'Internacional' )
                        + '\n' + 'Precio publicado: $' + Number(item.price).toLocaleString('en-US') + ' USD\n\n'
                        + 'Me gustaria conocer disponibilidad y opciones de financiamiento. ¡Muchas gracias!' ; } %>
                        <a href="https://wa.me/<%= empresaWA %>?text=<%= encodeURIComponent(waMsg) %>" target="_blank"
                          class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-2.5 py-1.5 rounded-lg text-[11px] uppercase tracking-wide transition-all duration-200 shadow-md flex items-center gap-1">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                            stroke="currentColor" class="w-3.5 h-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                          </svg>
                          <span>COMPRAR</span>
                        </a>
                    </div>
                  </div>

                </div>
                <% }); %>
                  <% } %>

        </div>

        <!-- Estado Vacío -->
        <div id="empty-state"
          class="<%= (typeof aircrafts !== 'undefined' && aircrafts.length > 0) ? 'hidden' : '' %> text-center py-16 bg-slate-900/40 border border-slate-800/80 rounded-2xl backdrop-blur-md mt-6">

          <h3 class="text-base font-bold text-white">No se encontraron unidades</h3>
          <p class="text-slate-400 text-xs mt-1 max-w-md mx-auto leading-relaxed">
            Intenta ajustar los límites de precio o realiza una búsqueda libre. Si requieres un modelo específico,
            contáctanos directamente.
          </p>
          <a href="https://wa.me/584120000000?text=Hola,%20busco%20una%20aeronave%20o%20repuesto%20especifico"
            target="_blank"
            class="inline-block mt-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs uppercase tracking-wider transition-all duration-200">
            Consultar Asesor VIP
          </a>
        </div>

      </section>
    </main>

    <!-- Script de Filtrado Dinámico por Rango de Precio -->
    <script>
      let currentCategory = 'all';

      function setCategory(category) {
        currentCategory = category;

        document.querySelectorAll('.tab-btn').forEach(btn => {
          btn.classList.remove('bg-amber-500', 'text-slate-950', 'font-semibold', 'shadow-md');
          btn.classList.add('text-slate-400', 'font-medium');
        });

        const activeBtn = document.getElementById(`tab-${category}`);
        if (activeBtn) {
          activeBtn.classList.add('bg-amber-500', 'text-slate-950', 'font-semibold', 'shadow-md');
          activeBtn.classList.remove('text-slate-400', 'font-medium');
        }

        applyFilters();
      }

      function applyFilters() {
        const query = document.getElementById('search-input').value.toLowerCase();
        const minPrice = parseFloat(document.getElementById('min-price').value) || 0;
        const maxPrice = parseFloat(document.getElementById('max-price').value) || Infinity;
        const cards = document.querySelectorAll('.card-item');
        let visibleCount = 0;

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const price = parseFloat(card.getAttribute('data-price') || '0');
          const cardText = card.innerText.toLowerCase();

          // Pestaña
          const matchesCategory = (currentCategory === 'all' || category === currentCategory);
          // Texto
          const matchesText = cardText.includes(query);
          // Rango Dinámico Mínimo / Máximo
          const matchesPrice = (price >= minPrice && price <= maxPrice);

          if (matchesCategory && matchesText && matchesPrice) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Control de Estado Vacío
        const emptyState = document.getElementById('empty-state');
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      function resetFilters() {
        document.getElementById('search-input').value = '';
        document.getElementById('min-price').value = '0';
        document.getElementById('max-price').value = 'Infinity';
        setCategory('all');
      }
    </script>

    <!-- Inclusión de Footer -->
    <%- include('partials/footer') %>
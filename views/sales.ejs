                  <div class="flex items-center gap-1.5">🏭 <span><strong>Fab:</strong> Bombardier</span></div>
                  <div class="flex items-center gap-1.5">📅 <span><strong>Año:</strong> 2018</span></div>
                  <div class="flex items-center gap-1.5">⏱️ <span><strong>Horas:</strong> 1,850 hrs</span></div>
                  <div class="flex items-center gap-1.5">📜 <span><strong>Cert:</strong> FAA</span></div>
                </div>
              </div>
            </div>

            <div class="px-5 pb-5 pt-1 flex items-center justify-between border-t border-slate-800/40">
              <div>
                <span class="text-[9px] text-slate-400 uppercase tracking-widest block font-medium">Precio de
                  Lista</span>
                <span class="text-sm font-bold text-slate-100">$28,000,000 USD</span>
              </div>
              <a href="https://wa.me/584120000000?text=Hola,%20me%20interesa%20el%20Bombardier%20Global%206000"
                target="_blank"

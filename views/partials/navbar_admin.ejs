<!-- 
  ===================================================
  Componente: Navbar de Administración
  Descripción: Barra de navegación exclusiva para el Panel Administrativo (Transparente, centrada, logo agrandado y selector de bandera)
  =================================================== 
-->
<header class="skymaster-navbar" style="border-bottom: 1px solid rgba(197, 160, 89, 0.25);">
  <div class="nav-container">
    <!-- Logo SkyMaster Oficial (Agrandado) -->
    <a href="/admin/dashboard" class="brand-logo" title="SkyMaster Admin">
      <img src="/img/LogoSky.png" alt="SkyMaster Admin" class="navbar-logo-img">
    </a>

    <!-- Enlaces Administrativos Centralizados en Montserrat -->
    <nav>
      <ul class="nav-links">
        <li><a href="/admin/dashboard" class="<%= typeof currentPath !== 'undefined' && currentPath.includes('/dashboard') ? 'active' : '' %>">Dashboard</a></li>
        <li><a href="/admin/inventario" class="<%= typeof currentPath !== 'undefined' && currentPath.includes('/inventario') ? 'active' : '' %>">Inventario</a></li>
        <li><a href="/admin/operaciones" class="<%= typeof currentPath !== 'undefined' && currentPath.includes('/operaciones') ? 'active' : '' %>">Operaciones</a></li>
        <li><a href="/admin/candidatos" class="<%= typeof currentPath !== 'undefined' && currentPath.includes('/candidatos') ? 'active' : '' %>">Candidatos</a></li>
        <li><a href="/admin/configuracion" class="<%= typeof currentPath !== 'undefined' && currentPath.includes('/configuracion') ? 'active' : '' %>">Configuración</a></li>
      </ul>
    </nav>

    <!-- Acciones Minimalistas de Administración -->
    <div class="nav-actions">
      <!-- Selector de Idioma (Alterna entre USA y Venezuela al dar clic) -->
      <button id="lang-toggle-btn-admin" class="nav-icon-btn lang-toggle" data-lang="en" title="Cambiar idioma (EN / ES)" aria-label="Cambiar idioma" type="button">
        <!-- Bandera Estados Unidos (Predeterminada) -->
        <span class="flag-icon flag-us">
          <svg viewBox="0 0 640 480" width="21" height="15" style="border-radius: 2px; display: block; box-shadow: 0 0 2px rgba(0,0,0,0.5);">
            <path fill="#bd3d44" d="M0 0h640v480H0z"/>
            <path stroke="#fff" stroke-width="37" d="M0 55.5h640M0 129.5h640M0 203.5h640M0 277.5h640M0 351.5h640M0 425.5h640"/>
            <path fill="#192f5d" d="M0 0h256v259H0z"/>
            <circle cx="35" cy="35" r="7" fill="#fff"/>
            <circle cx="85" cy="35" r="7" fill="#fff"/>
            <circle cx="135" cy="35" r="7" fill="#fff"/>
            <circle cx="185" cy="35" r="7" fill="#fff"/>
            <circle cx="60" cy="70" r="7" fill="#fff"/>
            <circle cx="110" cy="70" r="7" fill="#fff"/>
            <circle cx="160" cy="70" r="7" fill="#fff"/>
            <circle cx="210" cy="70" r="7" fill="#fff"/>
            <circle cx="35" cy="105" r="7" fill="#fff"/>
            <circle cx="85" cy="105" r="7" fill="#fff"/>
            <circle cx="135" cy="105" r="7" fill="#fff"/>
            <circle cx="185" cy="105" r="7" fill="#fff"/>
            <circle cx="60" cy="140" r="7" fill="#fff"/>
            <circle cx="110" cy="140" r="7" fill="#fff"/>
            <circle cx="160" cy="140" r="7" fill="#fff"/>
            <circle cx="210" cy="140" r="7" fill="#fff"/>
            <circle cx="35" cy="175" r="7" fill="#fff"/>
            <circle cx="85" cy="175" r="7" fill="#fff"/>
            <circle cx="135" cy="175" r="7" fill="#fff"/>
            <circle cx="185" cy="175" r="7" fill="#fff"/>
            <circle cx="60" cy="210" r="7" fill="#fff"/>
            <circle cx="110" cy="210" r="7" fill="#fff"/>
            <circle cx="160" cy="210" r="7" fill="#fff"/>
            <circle cx="210" cy="210" r="7" fill="#fff"/>
          </svg>
        </span>

        <!-- Bandera Venezuela (Alterna al dar clic) -->
        <span class="flag-icon flag-ve" style="display: none;">
          <svg viewBox="0 0 640 480" width="21" height="15" style="border-radius: 2px; display: block; box-shadow: 0 0 2px rgba(0,0,0,0.5);">
            <path fill="#cf142b" d="M0 0h640v480H0z"/>
            <path fill="#00247d" d="M0 0h640v320H0z"/>
            <path fill="#fecb00" d="M0 0h640v160H0z"/>
            <circle cx="205" cy="245" r="6" fill="#fff"/>
            <circle cx="235" cy="225" r="6" fill="#fff"/>
            <circle cx="275" cy="213" r="6" fill="#fff"/>
            <circle cx="320" cy="209" r="6" fill="#fff"/>
            <circle cx="365" cy="213" r="6" fill="#fff"/>
            <circle cx="405" cy="225" r="6" fill="#fff"/>
            <circle cx="435" cy="245" r="6" fill="#fff"/>
            <circle cx="320" cy="235" r="6" fill="#fff"/>
          </svg>
        </span>
      </button>

      <!-- Ver Portal Público -->
      <a href="/" class="nav-icon-btn" title="Ir al Portal Público" aria-label="Portal Público">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>

      <!-- Cerrar Sesión -->
      <a href="/auth/logout" class="nav-icon-btn" title="Cerrar Sesión" aria-label="Cerrar Sesión" style="border-color: rgba(239, 68, 68, 0.4); color: #fca5a5;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </a>

      <!-- Botón Hamburguesa para Dispositivos Móviles -->
      <button class="nav-icon-btn nav-hamburger" id="nav-hamburger-admin" aria-label="Abrir Menú" aria-expanded="false" type="button">
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

      <!-- ============================================================
       SCRIPTS MÓDULO CAREERS — Osuna
       ============================================================ -->
      <script>
        // Pre-llenar posición en el select desde los botones de vacante
        function prefillPosition(posVal) {
          if (!posVal) return;
          const sel = document.getElementById('position');
          if (sel) {
            const cleanPos = posVal.trim().toLowerCase();
            let matchedOpt = null;

            // 1. Coincidencia directa o contenida
            for (let opt of sel.options) {
              if (!opt.value) continue;
              const val = opt.value.trim().toLowerCase();
              const txt = opt.text.trim().toLowerCase();
              if (val === cleanPos || txt === cleanPos || val.includes(cleanPos) || cleanPos.includes(val) || txt.includes(cleanPos)) {
                matchedOpt = opt;
                break;
              }
            }

            // 2. Coincidencia semántica por palabras clave
            if (!matchedOpt) {
              for (let opt of sel.options) {
                if (!opt.value) continue;
                const haystack = (opt.value + ' ' + opt.text).toLowerCase();
                if (
                  (cleanPos.includes('piloto') && haystack.includes('piloto')) ||
                  (cleanPos.includes('capitán') && haystack.includes('capitán')) ||
                  (cleanPos.includes('tripulante') && haystack.includes('tripulante')) ||
                  (cleanPos.includes('cabina') && haystack.includes('cabina')) ||
                  (cleanPos.includes('mecánico') && (haystack.includes('mecánico') || haystack.includes('mantenimiento'))) ||
                  (cleanPos.includes('tma') && (haystack.includes('tma') || haystack.includes('mantenimiento')))
                ) {
                  matchedOpt = opt;
                  break;
                }
              }
            }

            if (matchedOpt) {
              sel.value = matchedOpt.value;
            } else {
              // Si no existe, crear la opción y seleccionarla
              const newOpt = document.createElement('option');
              newOpt.value = posVal;
              newOpt.textContent = posVal;
              sel.appendChild(newOpt);
              sel.value = posVal;
            }

            sel.classList.remove('invalid');
            sel.classList.add('valid');
          }

          // Cambiar a la pestaña de postular
          const tabPostular = document.getElementById('tab-postular');
          if (tabPostular) {
            tabPostular.click();
          }

          // Scroll suave al formulario
          setTimeout(() => {
            const panel = document.getElementById('panel-postular');
            if (panel) {
              panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }, 80);
        }

        // Si la URL contiene #postular, abrir el tab automáticamente
        if (window.location.hash === '#postular') {
          const tabPostular = document.getElementById('tab-postular');
          if (tabPostular) { tabPostular.click(); }
        }

        // File upload — mostrar nombre del archivo y cambiar estilo
        const cvInput = document.getElementById('cv_file');
        const cvLabel = document.getElementById('cv-file-name');
        const dropZone = document.getElementById('cv-drop-zone');

        cvInput.addEventListener('change', function () {
          if (this.files && this.files[0]) {
            cvLabel.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> ${this.files[0].name}`;
            dropZone.style.borderColor = 'var(--accent-gold)';
          } else {
            cvLabel.innerHTML = '';
            dropZone.style.borderColor = '';
          }
        });

        // Drag & Drop nativo
        dropZone.addEventListener('dragover', function (e) {
          e.preventDefault();
          this.classList.add('drag-active');
        });
        dropZone.addEventListener('dragleave', function () {
          this.classList.remove('drag-active');
        });
        dropZone.addEventListener('drop', function (e) {
          e.preventDefault();
          this.classList.remove('drag-active');
          const f = e.dataTransfer.files;
          if (f.length && f[0].type === 'application/pdf') {
            cvInput.files = f;
            cvLabel.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> ${f[0].name}`;
            this.style.borderColor = 'var(--accent-gold)';
          }
        });

        // Tabs logic
        const tabs = document.querySelectorAll('.ctab-btn');
        const panels = document.querySelectorAll('.ctab-panel');

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            // Remove active class from all
            tabs.forEach(t => t.classList.remove('active'));
            panels.forEach(p => p.classList.remove('active'));

            // Add active class to clicked tab and corresponding panel
            tab.classList.add('active');
            const panelId = tab.getAttribute('aria-controls');
            document.getElementById(panelId).classList.add('active');
          });
        });

        // ── Validaciones de formulario ──

        // Letras, tildes, espacios y guiones únicamente
        const NAME_RE = /^[\p{L}\s\-']+$/u;
        function validateName(el, errId) {
          const val = el.value.trim();
          const errEl = document.getElementById(errId);
          const ok = val.length > 0 && NAME_RE.test(val) && val.length <= parseInt(el.maxLength);
          el.classList.toggle('invalid', !ok);
          el.classList.toggle('valid',  ok);
          if (errEl) errEl.classList.toggle('show', !ok && val.length > 0);
          return ok;
        }

        function validateEmail(el) {
          const val = el.value.trim();
          const ok = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val);
          el.classList.toggle('invalid', !ok);
          el.classList.toggle('valid',  ok);
          const errEl = document.getElementById('err-email');
          if (errEl) errEl.classList.toggle('show', !ok && val.length > 0);
          return ok;
        }

        function countChars(el, max, counterId) {
          const len = el.value.length;
          const el2 = document.getElementById(counterId);
          if (!el2) return;
          el2.textContent = len + ' / ' + max;
          el2.className = 'char-counter' + (len >= max ? ' over' : len >= max * 0.85 ? ' warn' : '');
        }

        // ── Custom Country Picker con Banderas Reales (FlagCDN) ──
        const COUNTRIES = [
          { iso:'ve', name:'Venezuela',        code:'+58',   min:10, max:11, ph:'412 1234567' },
          { iso:'us', name:'Estados Unidos',   code:'+1',    min:10, max:10, ph:'555 1234567' },
          { iso:'co', name:'Colombia',         code:'+57',   min:10, max:10, ph:'300 1234567' },
          { iso:'es', name:'España',           code:'+34',   min:9,  max:9,  ph:'612 345678'  },
          { iso:'mx', name:'México',           code:'+52',   min:10, max:10, ph:'55 12345678' },
          { iso:'ar', name:'Argentina',        code:'+54',   min:10, max:11, ph:'11 12345678' },
          { iso:'cl', name:'Chile',            code:'+56',   min:9,  max:9,  ph:'9 12345678'  },
          { iso:'pe', name:'Perú',             code:'+51',   min:9,  max:9,  ph:'912 345678'  },
          { iso:'ec', name:'Ecuador',          code:'+593',  min:9,  max:9,  ph:'99 1234567'  },
          { iso:'pa', name:'Panamá',           code:'+507',  min:8,  max:8,  ph:'6123 4567'   },
          { iso:'cr', name:'Costa Rica',       code:'+506',  min:8,  max:8,  ph:'8123 4567'   },
          { iso:'br', name:'Brasil',           code:'+55',   min:10, max:11, ph:'11 912345678'},
          { iso:'do', name:'Rep. Dominicana',  code:'+1809', min:7,  max:10, ph:'809 1234567' },
          { iso:'gt', name:'Guatemala',        code:'+502',  min:8,  max:8,  ph:'5123 4567'   },
          { iso:'cu', name:'Cuba',             code:'+53',   min:8,  max:8,  ph:'5123 4567'   },
          { iso:'gb', name:'Reino Unido',      code:'+44',   min:10, max:10, ph:'7123 456789' },
          { iso:'fr', name:'Francia',          code:'+33',   min:9,  max:9,  ph:'6 12 34 56 78'},
          { iso:'de', name:'Alemania',         code:'+49',   min:10, max:12, ph:'151 23456789'},
          { iso:'it', name:'Italia',           code:'+39',   min:9,  max:10, ph:'312 3456789' },
          { iso:'un', name:'Otro país',        code:'',      min:7,  max:15, ph:'123456789'   },
        ];

        let selectedCountry = COUNTRIES[0];

        function buildCountryPicker() {
          const dropdown = document.getElementById('cp-dropdown');
          if (!dropdown) return;
          dropdown.innerHTML = '';
          COUNTRIES.forEach((c, i) => {
            const item = document.createElement('div');
            item.className = 'country-picker-item' + (i === 0 ? ' selected' : '');
            item.setAttribute('role', 'option');
            item.innerHTML = `
              <img src="https://flagcdn.com/w40/${c.iso}.png" alt="${c.name}" class="cp-flag-img" loading="lazy">
              <span class="country-picker-item-name">${c.name}</span>
              <span class="country-picker-item-code">${c.code}</span>`;
            item.addEventListener('click', () => selectCountry(c));
            dropdown.appendChild(item);
          });
        }

        function selectCountry(c) {
          selectedCountry = c;
          const flagEl = document.getElementById('cp-flag');
          if (flagEl) {
            flagEl.innerHTML = `<img src="https://flagcdn.com/w40/${c.iso}.png" alt="${c.name}" class="cp-flag-img">`;
          }
          const codeEl = document.getElementById('cp-code');
          if (codeEl) codeEl.textContent = c.code || 'Otro';

          // Actualizar ítem seleccionado en el menú desplegable
          document.querySelectorAll('.country-picker-item').forEach(el => {
            const nameEl = el.querySelector('.country-picker-item-name');
            el.classList.toggle('selected', nameEl && nameEl.textContent === c.name);
          });

          // Actualizar input y restricciones de longitud
          const inp = document.getElementById('phone_number');
          if (inp) {
            inp.placeholder = c.ph;
            inp.maxLength = c.max;

            // Recortar si lo que tiene supera el nuevo max
            let digits = inp.value.replace(/\D/g, '');
            if (digits.length > c.max) {
              digits = digits.slice(0, c.max);
              inp.value = digits;
            }
            syncPhone();

            // Si tiene datos, revalidar contra el nuevo país
            if (inp.value.length > 0) {
              validatePhone(true);
            } else {
              inp.classList.remove('invalid', 'valid');
              const errEl = document.getElementById('err-phone');
              if (errEl) errEl.classList.remove('show');
            }
          }
          closeCountryPicker();
        }

        function toggleCountryPicker() {
          const picker = document.getElementById('country-picker');
          if (picker) {
            picker.classList.toggle('open');
            const btn = document.getElementById('cp-btn');
            if (btn) btn.setAttribute('aria-expanded', picker.classList.contains('open'));
          }
        }
        function closeCountryPicker() {
          const picker = document.getElementById('country-picker');
          if (picker) {
            picker.classList.remove('open');
            const btn = document.getElementById('cp-btn');
            if (btn) btn.setAttribute('aria-expanded', 'false');
          }
        }

        // Cerrar picker al hacer clic fuera
        document.addEventListener('click', (e) => {
          const picker = document.getElementById('country-picker');
          if (picker && !picker.contains(e.target)) closeCountryPicker();
        });

        function syncPhone() {
          const inp = document.getElementById('phone_number');
          const hiddenPhone = document.getElementById('phone');
          if (!inp || !hiddenPhone) return;
          const code = (selectedCountry && selectedCountry.code) ? selectedCountry.code : '';
          const digits = inp.value.replace(/\D/g, '');
          hiddenPhone.value = digits ? (code + digits) : '';
        }

        // Impedir teclear más caracteres de los permitidos por el país seleccionado
        function handlePhoneKeyDown(e) {
          const allowed = ['Backspace', 'Tab', 'ArrowLeft', 'ArrowRight', 'Delete', 'Enter'];
          if (allowed.includes(e.key) || e.ctrlKey || e.metaKey) return;
          if (!/^[0-9]$/.test(e.key)) {
            e.preventDefault();
            return;
          }
          const inp = e.target;
          const digits = inp.value.replace(/\D/g, '');
          const hasSelection = inp.selectionStart !== inp.selectionEnd;
          if (!hasSelection && selectedCountry && digits.length >= selectedCountry.max) {
            e.preventDefault();
          }
        }

        // Limpieza de caracteres y truncado exacto
        function handlePhoneInput(inp) {
          let digits = inp.value.replace(/\D/g, '');
          const max = (selectedCountry && selectedCountry.max) ? selectedCountry.max : 15;
          if (digits.length > max) {
            digits = digits.slice(0, max);
          }
          inp.value = digits;
          syncPhone();

          const min = (selectedCountry && selectedCountry.min) ? selectedCountry.min : 7;
          const errEl = document.getElementById('err-phone');
          const ok = digits.length >= min && digits.length <= max;
          if (ok) {
            inp.classList.remove('invalid');
            inp.classList.add('valid');
            if (errEl) errEl.classList.remove('show');
          } else if (inp.classList.contains('invalid')) {
            validatePhone(false);
          }
        }

        function validatePhone(showError = true) {
          const inp = document.getElementById('phone_number');
          if (!inp) return false;
          const digits = inp.value.replace(/\D/g, '');
          const min = (selectedCountry && selectedCountry.min) ? selectedCountry.min : 7;
          const max = (selectedCountry && selectedCountry.max) ? selectedCountry.max : 15;
          const ok = digits.length >= min && digits.length <= max;

          if (showError || digits.length > 0) {
            inp.classList.toggle('invalid', !ok);
            inp.classList.toggle('valid', ok);
          }

          const errEl = document.getElementById('err-phone');
          if (errEl) {
            if (!ok) {
              if (digits.length === 0) {
                errEl.textContent = 'El número de teléfono es obligatorio.';
              } else if (min === max) {
                errEl.textContent = `Debe tener exactamente ${max} dígitos para ${selectedCountry.name}. (Tienes ${digits.length})`;
              } else {
                errEl.textContent = `Debe tener entre ${min} y ${max} dígitos para ${selectedCountry.name}. (Tienes ${digits.length})`;
              }
            }
            if (showError) {
              errEl.classList.toggle('show', !ok);
            }
          }
          return ok;
        }

        function validatePhoneOnBlur() {
          syncPhone();
          validatePhone(true);
        }

        // Inicializar picker
        buildCountryPicker();

        // ── Validación al enviar ──
        const form = document.getElementById('apply-form');
        const submitBtn = document.getElementById('submit-btn');
        if (form) {
          form.addEventListener('submit', function (e) {
            let valid = true;

            // Nombre
            if (!validateName(document.getElementById('first_name'), 'err-first_name')) valid = false;
            // Apellido
            if (!validateName(document.getElementById('last_name'), 'err-last_name')) valid = false;
            // País, Ciudad
            if (!validateName(document.getElementById('country'), 'err-country')) valid = false;
            if (!validateName(document.getElementById('city'),    'err-city'))    valid = false;
            // Teléfono
            if (!validatePhone(true)) valid = false;
            // Email
            if (!validateEmail(document.getElementById('email'))) valid = false;
            // Posición
            const posEl = document.getElementById('position');
            if (!posEl.value) {
              posEl.classList.add('invalid'); valid = false;
            } else {
              posEl.classList.remove('invalid');
            }
            // Licencia y Pasaporte
            const licEl = document.getElementById('has_license');
            if (licEl && !licEl.value) { licEl.classList.add('invalid'); valid = false; }
            const pasEl = document.getElementById('has_passport');
            if (pasEl && !pasEl.value) { pasEl.classList.add('invalid'); valid = false; }
            // Idiomas
            const langEl = document.getElementById('languages');
            if (langEl && (!langEl.value.trim() || langEl.value.length > 150)) { langEl.classList.add('invalid'); valid = false; }

            if (!valid) {
              e.preventDefault();
              // Scroll al primer error
              const firstErr = form.querySelector('.invalid, .field-error.show');
              if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
              return;
            }

            // Asegurar que el campo oculto de teléfono tiene valor
            syncPhone();
            if (!document.getElementById('phone').value) { e.preventDefault(); return; }

            submitBtn.disabled = true;
            submitBtn.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="animation:spin .9s linear infinite">
            <line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/>
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
            <line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/>
            <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
          </svg>
          Enviando candidatura...`;
          });
        }

        // ── Toast Notification ──
        function closeToast() {
          const toast = document.getElementById('careers-toast');
          if (toast) { toast.classList.remove('show'); setTimeout(() => toast.remove(), 500); }
        }

        const toast = document.getElementById('careers-toast');
        if (toast) {
          // Remover parametros de la URL para que no salga el toast de nuevo si recarga (F5)
          if (window.history.replaceState) {
            const url = new URL(window.location);
            url.searchParams.delete('success');
            url.searchParams.delete('error');
            window.history.replaceState({path:url.href}, '', url.href);
          }

          // Si hay un toast (mensaje de éxito o error de postulación), abrir automáticamente el tab de Postularme
          const btnPostular = document.getElementById('tab-postular');
          if (btnPostular) { btnPostular.click(); }
          
          setTimeout(() => toast.classList.add('show'), 100);
          setTimeout(() => closeToast(), 8000); // Ocultar despues de 8 segundos
        }
      </script>

      <style>
        @keyframes spin {
          from {
            transform: rotate(0deg);
          }

          to {
            transform: rotate(360deg);
          }
        }
      </style>

</body>

</html>
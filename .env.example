# ===================================================
# SKYMASTER - VARIABLES DE ENTORNO (CONFIGURACIÓN)
# ===================================================
# Copia este archivo y renómbralo a '.env' para tu entorno local
# En Hostinger, configura estas variables desde el panel de Node.js o el archivo .env en la raíz

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos MySQL (Hostinger / Local)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=skymaster_db
DB_PORT=3306

# Configuración de Sesiones / Seguridad
SESSION_SECRET=skymaster_secret_session_key_2026_change_in_production
